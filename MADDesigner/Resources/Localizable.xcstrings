    "NATURAL joins have no place in the model: a link names one field pair.": {
      "comment": "SQL statement validation message for a pasted statement.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NATURAL-Joins haben im Modell keinen Platz: Eine Verknüpfung benennt ein Feldpaar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las uniones NATURAL no tienen cabida en el modelo: un vínculo nombra un par de campos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NATURAL 結合はモデルで使用できません。リンクは 1 組のフィールドを指定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junções NATURAL não têm lugar no modelo: um vínculo nomeia um par de campos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NATURAL 联接不能出现在模型中：每个链接只指定一对字段。"
          }
        }
      }
    },
    "NOT has no place in the model: a predicate holds one comparison, not its negation.": {
      "comment": "SQL statement validation message for a pasted statement.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NOT hat im Modell keinen Platz: Ein Prädikat enthält einen Vergleich, nicht seine Negation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NOT no tiene cabida en el modelo: un predicado contiene una comparación, no su negación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NOT はモデルで使用できません。述語は 1 つの比較を保持し、その否定は保持しません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NOT não tem lugar no modelo: um predicado contém uma comparação, não sua negação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NOT 不能出现在模型中：谓词只包含一次比较，而不是其否定。"
          }
        }
