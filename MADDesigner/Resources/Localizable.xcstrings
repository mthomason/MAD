        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las uniones CROSS no tienen cabida en el modelo: un vínculo nombra un par de campos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CROSS 結合はモデルで使用できません。リンクは 1 組のフィールドを指定します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Junções CROSS não têm lugar no modelo: um vínculo nomeia um par de campos."
