    "Place data fields, static labels, aggregate functions, barcodes, and shapes across Report Header, Page Header, Group Headers and Footers, Detail, Page Footer, and Report Footer sections.": {
      "comment": "Step 3 body",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie Datenfelder, statische Beschriftungen, Aggregatfunktionen, Barcodes und Formen in den Abschnitten Berichtskopf, Seitenkopf, Gruppenköpfe und -füße, Detail, Seitenfuß und Berichtsfuß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque campos de datos, etiquetas estáticas, funciones de agregado, códigos de barras y formas en las secciones Encabezado del informe, Encabezado de página, Encabezados y pies de grupo, Detalle, Pie de página y Pie del informe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データフィールド、静的ラベル、集計関数、バーコード、図形を、レポートヘッダー、ページヘッダー、グループヘッダーとフッター、詳細、ページフッター、レポートフッターの各セクションに配置します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicione campos de dados, rótulos estáticos, funções de agregação, códigos de barras e formas nas seções Cabeçalho do Relatório, Cabeçalho da Página, Cabeçalhos e Rodapés de Grupo, Detalhe, Rodapé da Página e Rodapé do Relatório."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在报表页眉、页眉、组页眉和组页脚、明细、页脚以及报表页脚区域中放置数据字段、静态标签、聚合函数、条码和形状。"
