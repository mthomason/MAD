    "MAD Designer connects natively to MySQL / MariaDB, Microsoft SQL Server, and PostgreSQL databases, and uses SQLite for portable sample documents and local row caching.": {
      "comment": "Overview paragraph 2",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MAD Designer verbindet sich nativ mit MySQL / MariaDB-, Microsoft SQL Server- und PostgreSQL-Datenbanken und verwendet SQLite für portable Beispieldokumente und lokales Zeilen-Caching."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MAD Designer se conecta de forma nativa a bases de datos MySQL / MariaDB, Microsoft SQL Server y PostgreSQL, y usa SQLite para documentos de ejemplo portátiles y el almacenamiento en caché local de filas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MAD Designer は MySQL / MariaDB、Microsoft SQL Server、PostgreSQL データベースにネイティブ接続し、SQLite をポータブルなサンプルドキュメントとローカル行キャッシュに使用します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MAD Designer se conecta nativamente a bancos de dados MySQL / MariaDB, Microsoft SQL Server e PostgreSQL, e usa SQLite para documentos de exemplo portáteis e cache local de linhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MAD Designer 原生连接到 MySQL / MariaDB、Microsoft SQL Server 和 PostgreSQL 数据库，并使用 SQLite 处理便携示例文档和本地行缓存。"
          }
        }
      }
    },
    "MAD Designer could not find the SQLite database file for this report at:\n%@\n\nWould you like to locate the database file on your Mac?": {
      "comment": "Refresh alert body. %@ is the expected file path. The last sentence asks whether to open a file chooser.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MAD Designer konnte die SQLite-Datenbankdatei für diesen Bericht unter folgendem Pfad nicht finden:\n%@\n\nMöchten Sie die Datenbankdatei auf Ihrem Mac suchen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MAD Designer no pudo encontrar el archivo de base de datos SQLite de este informe en:\n%@\n\n¿Desea buscar el archivo de base de datos en su Mac?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MAD Designer はこのレポートの SQLite データベースファイルを次の場所で見つけられませんでした:\n%@\n\nMac 上でデータベースファイルを検索しますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MAD Designer não conseguiu encontrar o arquivo de banco de dados SQLite deste relatório em:\n%@\n\nDeseja localizar o arquivo de banco de dados no seu Mac?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MAD Designer 找不到此报表的 SQLite 数据库文件，其位置为：\n%@\n\n要在 Mac 上定位该数据库文件吗？"
          }
        }
      }
    },
