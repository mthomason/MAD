    },
    "Add tables, joins, filter predicates, groupings, and sort order visually, or paste a SQL SELECT statement directly. MAD generates the database-specific SQL automatically.": {
      "comment": "Step 2 body",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Tabellen, Joins, Filterprädikate, Gruppierungen und Sortierreihenfolgen visuell hinzu, oder fügen Sie eine SQL-SELECT-Anweisung direkt ein. MAD generiert das datenbankspezifische SQL automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue tablas, uniones, predicados de filtro, agrupaciones y orden de clasificación de forma visual, o pegue directamente una instrucción SELECT de SQL. MAD genera automáticamente el SQL específico de la base de datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーブル、結合、フィルタ述語、グループ化、並べ替え順序をビジュアルに追加するか、SQL SELECT ステートメントを直接貼り付けます。MAD がデータベース固有の SQL を自動的に生成します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione tabelas, junções, predicados de filtro, agrupamentos e ordem de classificação visualmente, ou cole uma instrução SQL SELECT diretamente. O MAD gera o SQL específico do banco de dados automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以可视化方式添加表、联接、筛选谓词、分组和排序顺序，或直接粘贴 SQL SELECT 语句。MAD 会自动生成特定于数据库的 SQL。"
          }
        }
      }
    },
