      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionen und Ausdrücke haben im Modell keinen Platz: Eine Prädikatseite ist eine Spalte oder ein Literal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones y expresiones no tienen cabida en el modelo: un lado del predicado es una columna o un literal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関数と式はモデルで使用できません。述語の各辺は列またはリテラルです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funções e expressões não têm lugar no modelo: um lado do predicado é uma coluna ou um literal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "函数和表达式不能出现在模型中：谓词的一侧是列或字面量。"
          }
        }
      }
    },
    "Functions and expressions have no place in the select list: the model holds column references.": {
      "comment": "SQL statement validation message for a pasted statement.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionen und Ausdrücke haben in der Auswahlliste keinen Platz: Das Modell enthält Spaltenreferenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones y expresiones no tienen cabida en la lista de selección: el modelo contiene referencias a columnas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関数と式は選択リストで使用できません。モデルは列参照を保持します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funções e expressões não têm lugar na lista de seleção: o modelo contém referências de coluna."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "函数和表达式不能出现在选择列表中：模型中保存的是列引用。"
          }
        }
      }
    },
