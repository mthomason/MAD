    "The link model holds one `left = right` condition per join -- split the extra conditions into the WHERE clause.": {
      "comment": "SQL statement validation message for a pasted statement.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verknüpfungsmodell enthält eine Bedingung `left = right` pro Join -- teilen Sie die zusätzlichen Bedingungen auf die WHERE-Klausel auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de vínculos contiene una condición `left = right` por unión; divida las condiciones adicionales en la cláusula WHERE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクモデルは結合ごとに 1 つの `left = right` 条件を保持します。追加の条件は WHERE 句に分割してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de vínculo contém uma condição `left = right` por junção -- separe as condições extras na cláusula WHERE."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接模型在每个联接中只保留一个 `left = right` 条件 -- 请将多余的条件拆分到 WHERE 子句中。"
          }
        }
      }
    },
    "The link model holds one `left = right` condition per join.": {
      "comment": "SQL statement validation message for a pasted statement.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verknüpfungsmodell enthält eine Bedingung `left = right` pro Join."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de vínculos contiene una condición `left = right` por unión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクモデルは結合ごとに 1 つの `left = right` 条件を保持します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
