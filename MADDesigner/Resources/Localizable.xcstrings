    "CROSS joins have no place in the model: a link names one field pair.": {
      "comment": "SQL statement validation message for a pasted statement.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CROSS-Joins haben im Modell keinen Platz: Eine Verknüpfung benennt ein Feldpaar."
          }
