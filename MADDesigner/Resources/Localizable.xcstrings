    },
    "The model has no free sort: every ORDER BY column must be a GROUP BY column.": {
      "comment": "SQL statement validation message for a pasted statement.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell kennt keine freie Sortierung: Jede ORDER BY-Spalte muss eine GROUP BY-Spalte sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo no tiene clasificación libre: cada columna ORDER BY debe ser una columna GROUP BY."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルには自由な並べ替えがありません。すべての ORDER BY 列は GROUP BY 列である必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo não tem classificação livre: toda coluna ORDER BY deve ser uma coluna GROUP BY."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型不支持自由排序：每个 ORDER BY 列都必须是 GROUP BY 列。"
          }
        }
      }
    },
