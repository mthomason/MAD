%{
    
    #import <Foundation/Foundation.h>
    #import "MessageBlocks.h"
    #import "MTPair.h"
    #import "MADSymbol.h"
    #import "MADSymbolReference.h"
    #import "MTAstNodeComparson.h"
    #import "MTAbstractSyntaxTree.h"
    #import "MTAstNodeArithmetic.h"
    #import "MTAstNodeNumberValue.h"
    #import "MTAstNodeFunctionCallEmbedded.h"
    #import "MTAstNodeSymbolReference.h"
    #import "MTAstNodeSymbolAsignNumber.h"
    #import "MTAstNodeFlow.h"
    #import "MTAstNodeExpression.h"
    #import "MTAstNodeStatement.h"
    #import "MTAstNodeResult.h"
    #import "MTAstNodeStatementList.h"
    #import "MTAstNodeStringValue.h"
    #import "MTAstNodeBoolValue.h"
    #import "MADValue.h"
    
    //#define YYDEBUG 1

    int yylex(void);
    void yyerror(char *s, ...);
    void sc_return(MTAbstractSyntaxTree *result);
    double sc_control_if(bool expression, double list);

    MADSymbol *sc_symbol_for_key(NSString *symbol);

    MTAstNodeArithmetic *nodeForArithmeticOfValues(SCArithmetic arithmeticType, MTAbstractSyntaxTree *leftValue, MTAbstractSyntaxTree *rightValue);
    MTAstNodeComparson *nodeForComparsonOfValues(NSInteger comparsonType, MTAbstractSyntaxTree *leftValue, MTAbstractSyntaxTree *rightValue);
    MTAstNodeFunctionCallEmbedded *nodeForEmbeddedFunctionAndValues(SCFunctionType function, NSArray *values);
    MTAstNodeNumberValue *nodeForNumber(double n);
    MTAstNodeSymbolReference *nodeForSymbolReference(MADSymbolReference *symbolReference);
    MTAstNodeSymbolAsignNumber *nodeForAssigningValueToSymbol(MADSymbol *symbol, MTAbstractSyntaxTree *value);
    MTAstNodeSymbolAsignNumber *nodeForAssigningValueToSymbolReference(MADSymbolReference *symbolReference, MTAbstractSyntaxTree *value);
    MTAstNodeFlow *nodeForIfThenStatement(MTAbstractSyntaxTree *expression, MTAbstractSyntaxTree *ifValue, MTAbstractSyntaxTree *thenValue);
    MTAstNodeExpression *nodeForExpression(MTAbstractSyntaxTree *expression);
    
    MTAstNodeStatement *nodeForStatement(MTAbstractSyntaxTree *statement);
    MTAstNodeStringValue *nodeForString(NSString *s);
    MTAstNodeBoolValue *nodeForBool(bool b);

    MTAstNodeResult *nodeForResult(MTAbstractSyntaxTree *expression);
    
    
    
    MTAstNodeStatementList *nodeForStatementAndList(MTAstNodeStatement *statement, MTAstNodeStatementList *list);
    //int yydebug = 1;
    

%}

%code requires {
    char *filename;
    
    typedef struct YYLTYPE {
        int first_line;
        int first_column;
        int last_line;
        int last_column;
        char *filename;
    } YYLTYPE;
    # define YYLTYPE_IS_DECLARED 1
    
    # define YYLLOC_DEFAULT(Current, Rhs, N) \
    do	\
        if (N) { \
            (Current).first_line   = YYRHSLOC (Rhs, 1).first_line; \
            (Current).first_column = YYRHSLOC (Rhs, 1).first_column; \
            (Current).last_line    = YYRHSLOC (Rhs, N).last_line; \
            (Current).last_column  = YYRHSLOC (Rhs, N).last_column;	\
            (Current).filename     = YYRHSLOC (Rhs, 1).filename; \
        } else {    /* empty RHS */ \
            (Current).first_line   = (Current).last_line   = YYRHSLOC (Rhs, 0).last_line; \
            (Current).first_column = (Current).last_column = YYRHSLOC (Rhs, 0).last_column;	\
            (Current).filename  = NULL; \
        } \
    while (0)
    
    #define YY_LOCATION_PRINT(File, Loc) \
                fprintf (File, "%d.%d-%d.%d", (Loc).first_line, (Loc).first_column, (Loc).last_line, (Loc).last_column)
}


%union {
    __unsafe_unretained MTAbstractSyntaxTree    *ast;
    NSInteger                                   fn;
    double                                      d;
    __unsafe_unretained NSNumber                *number;
    bool                                        b;
    __unsafe_unretained MADSymbol               *sym;
    __unsafe_unretained MADSymbolReference      *symref;
    __unsafe_unretained id                      value;
    __unsafe_unretained NSString                *identifier;
    __unsafe_unretained NSString                *strval;
}

%locations

%token <fn> COMPARESON
%token END_OF_LINE
%token END_OF_FILE
%token RETURN
%token VARABLE
%token <b> BOOLEAN
%token <strval> STRING

%token IF ELSE WHILE DO LET

%token <d> NUMBER
%token <symref> IDENTIFIER

%type <ast> list
%type <ast> stmt

%type <ast> exp
%type <ast> expstr
%type <ast> expnum
%type <ast> expbool

%type <ast> factor
%type <ast> term

%start scrimpt

%%

scrimpt:                                        { sc_return(nil); }
    | list                                      { sc_return($1); }
;

list: stmt list                                 { $$ = (MTAbstractSyntaxTree *)nodeForStatementAndList(nodeForStatement((MTAstNodeStatement *)$1), (MTAstNodeStatementList *)$2); }
    | stmt                                      { $$ = (MTAbstractSyntaxTree *)nodeForStatement($1); }
;

stmt: IF exp '{' list '}'                       { $$ = nodeForIfThenStatement($2, $4, nil); }
    | IF exp '{' list '}' ELSE '{' list '}'     { $$ = nodeForIfThenStatement($2, $4, $8); }
    | WHILE exp DO list                         { while ($2) { $$ = $4; } }
    | exp                                       { $$ = nodeForExpression($1); }

    | VARABLE IDENTIFIER '=' exp ';'            { $$ = nodeForAssigningValueToSymbolReference($2, $4); }
    | IDENTIFIER '=' exp ';'                    { $$ = nodeForAssigningValueToSymbolReference($1, $3); }
    | RETURN exp ';'                            { $$ = nodeForResult($2); }
    | ';'                                       { $$ = nil; }
;

exp : expstr                                    { $$ = $1; }
    | expnum                                    { $$ = $1; }
    | expbool                                   { $$ = $1; }
    | '(' exp ')'                               { $$ = nodeForExpression($2); }
    | exp COMPARESON exp                        { $$ = nodeForComparsonOfValues($2, $1, $3); }
;

expbool: BOOLEAN                                { $$ = nodeForBool($1); }
;

expstr: STRING                                  { $$ = nodeForString($1); }
;

expnum : '(' expnum ')'                         { $$ = nodeForExpression($2); }
    | factor                                    { $$ = nodeForExpression($1); }
    | expnum COMPARESON factor                  { $$ = nodeForComparsonOfValues($2, $1, $3); }
    | expnum '+' factor                         { $$ = nodeForArithmeticOfValues(SCArithmeticAdd, $1, $3); }
    | expnum '-' factor                         { $$ = nodeForArithmeticOfValues(SCArithmeticSubtract, $1, $3); }
;

factor : term                                   { $$ = nodeForExpression($1); }
    | factor '*' term                           { $$ = nodeForArithmeticOfValues(SCArithmeticMultiply, $1, $3); }
    | factor '/' term                           { $$ = nodeForArithmeticOfValues(SCArithmeticDivide, $1, $3); }
;

term : NUMBER                                   { $$ = nodeForNumber($1); }
    | IDENTIFIER                                { $$ = nodeForSymbolReference($1); }
    | '|' term                                  { $$ = nodeForEmbeddedFunctionAndValues(SCFunctionTypeAbsoluteValue, @[$2]); }
    | '-' term                                  { $$ = nodeForEmbeddedFunctionAndValues(SCFunctionTypeUniaryMinus, @[$2]); }
    | '(' expnum ')'                            { $$ = nodeForExpression($2); }
;

%%

MTAstNodeResult *nodeForResult(MTAbstractSyntaxTree *expression) {
    MTAstNodeResult *node = [[MTAstNodeResult alloc] initWithExpression:expression];
    return node;
}

MTAstNodeStatement *nodeForStatement(MTAbstractSyntaxTree *statement) {
    MTAstNodeStatement *node = [[MTAstNodeStatement alloc] initWithNode:statement];
    return node;
}

MTAstNodeExpression *nodeForExpression(MTAbstractSyntaxTree *expression) {
    MTAstNodeExpression *node = [[MTAstNodeExpression alloc] initWithNode:expression];
    return node;
}

MTAstNodeFlow *nodeForIfThenStatement(MTAbstractSyntaxTree *expression, MTAbstractSyntaxTree *ifValue, MTAbstractSyntaxTree *thenValue) {
    MTAstNodeFlow *node = [[MTAstNodeFlow alloc] initConditionalWithIfList:ifValue thenList:thenValue andCondition:expression];
    return node;
}

MTAstNodeSymbolAsignNumber *nodeForAssigningValueToSymbolReference(MADSymbolReference *symbolReference, MTAbstractSyntaxTree *value) {
    MADSymbol *sy = sc_symbol_for_key(symbolReference.symbol);
    return nodeForAssigningValueToSymbol(sy, value);
}

MTAstNodeSymbolAsignNumber *nodeForAssigningValueToSymbol(MADSymbol *symbol, MTAbstractSyntaxTree *value) {
    MTAstNodeSymbolAsignNumber *result = [[MTAstNodeSymbolAsignNumber alloc] initWithSymbol:symbol andValue: value];
    return result;
}

MTAstNodeSymbolReference *nodeForSymbolReference(MADSymbolReference *symbolReference) {
    MTAstNodeSymbolReference *node = [[MTAstNodeSymbolReference alloc] initWithSymbolReference:symbolReference];
    return node;
}

MTAstNodeNumberValue *nodeForNumber(double n) {
    MTAstNodeNumberValue *result = [[MTAstNodeNumberValue alloc] initWithNumber:n];
    return result;
}

MTAstNodeBoolValue *nodeForBool(bool b) {
    MTAstNodeBoolValue *result = [[MTAstNodeBoolValue alloc] initWithBool:b];
    return result;
}

MTAstNodeStringValue *nodeForString(NSString *s) {
    MTAstNodeStringValue *result = [[MTAstNodeStringValue alloc] initWithString:s];
    return result;
}

MTAstNodeFunctionCallEmbedded *nodeForEmbeddedFunctionAndValues(SCFunctionType function, NSArray *values) {
    id value = [values objectAtIndex:0];
    MTAstNodeFunctionCallEmbedded *result = [[MTAstNodeFunctionCallEmbedded alloc] initWithEmbededProcedure:function withValue:value];
    return result;
}

MTAstNodeArithmetic *nodeForArithmeticOfValues(SCArithmetic arithmeticType, MTAbstractSyntaxTree *leftValue, MTAbstractSyntaxTree *rightValue) {
    MTPair *values = [MTPair pairWithLeft:leftValue andRight:rightValue];
    MTAstNodeArithmetic *result = [[MTAstNodeArithmetic alloc] initWithArithmeticProcedure:arithmeticType withValues:values];
    return result;
}

MTAstNodeComparson *nodeForComparsonOfValues(NSInteger comparsonType, MTAbstractSyntaxTree *leftValue, MTAbstractSyntaxTree *rightValue) {
    MTPair *values = [MTPair pairWithLeft:leftValue andRight:rightValue];
    MTAstNodeComparson *result = [[MTAstNodeComparson alloc] initWithComparson:comparsonType ofValues:values];
    return result;
}

MTAstNodeStatementList *nodeForStatementAndList(MTAstNodeStatement *statement, MTAstNodeStatementList *list) {
    MTAstNodeStatementList *node = [[MTAstNodeStatementList alloc] initWithStatement:statement andList:list];
    return node;
}

void sc_return(MTAbstractSyntaxTree *value) {
    if (Scrimpted) {
        id result;
        if (value == nil) {
            result = nil;
        } else {
            MADValue *mv = [value evaluate];
            if (mv) {
                result = [mv value];
            } else {
                result = nil;
            }
        }
        Scrimpted(YES, result, nil);
    }
}

void
lyyerror(YYLTYPE t, char *s, ...) {
    va_list ap;
    va_start(ap, s);
    if (yylloc.first_line) {
        fprintf(stderr, "%d.%d-%d.%d: error: ", t.first_line, t.first_column, t.last_line, t.last_column);
    }
    vfprintf(stderr, s, ap);
    fprintf(stderr, "\n");
}

MADSymbol *sc_symbol_for_key(NSString *symbol) {
    MADSymbol *result = nil;
    if (ScrimptSymbol) {
        result = ScrimptSymbol(symbol);
    }
    return result;
}
