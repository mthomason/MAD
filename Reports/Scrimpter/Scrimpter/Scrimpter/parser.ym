%{

#import <Foundation/Foundation.h>
#import "MessageBlocks.h"

int yylex(void);
void yyerror(char *s);
void sc_return(id result);
bool sc_evaluate_compareson(SCCompareson comparson, double left, double right);
double sc_control_if(bool expression, double list);

%}

%union {
    struct ast                      *a;
    NSInteger                       fn;
    double                          d;
    bool                            b;
    __unsafe_unretained id          result;
    __unsafe_unretained NSString    *identifier;
}

%token ADD SUBTRACT MULTIPLY DIVIDE ABSOLUTE_VALUE
%token OPEN_PERN CLOSE_PERN
%token COMMA SIMICOLON
%token <b> COMPARESON
%token END_OF_LINE
%token END_OF_FILE
%token RETURN

%token IF THEN ELSE WHILE DO LET

%token NUMBER
%token IDENTIFIER

%type <result> scrimpt
%type <result> statements;
%type <result> statement;
%type <d> expression
%type <d> factor
%type <d> term

%%


scrimpt:
    | result                                            { $$ = NULL; }
    | statements result                                 { $$ = NULL; }
;

statements:                                             { }
    | statements statement SIMICOLON                    { }
    | statement SIMICOLON                               { }
;

result:
    | RETURN statement SIMICOLON                        { sc_return($2); }
    | statement SIMICOLON                               { sc_return($1); }
;

statement: IF expression THEN statements                {  }
    | IF expression THEN statements ELSE statements     {  }
    | WHILE expression DO statements                    {  }
    | expression                                        { double d = $1; $$ = [NSNumber numberWithDouble:d]; }
;

expression :
    | factor                                            { $$ = $1; }
    | expression COMPARESON factor                      { $$ = sc_evaluate_compareson($2, $1, $3); }
    | expression ADD factor                             { $$ = $1 + $3; }
    | expression SUBTRACT factor                        { $$ = $1 - $3; }
;

factor : term                                           { $$ = $1; }
    | factor MULTIPLY term                              { $$ = $1 * $3; }
    | factor DIVIDE term                                { $$ = $1 / $3; }
;

term : NUMBER
    | ABSOLUTE_VALUE term                               { $$ = $2 > 0 ? $2 : -$2; }
    | SUBTRACT term                                     { $$ = -$2; }
    | OPEN_PERN expression CLOSE_PERN                   { $$ = $2; }
;

%%

void sc_return(id result) {
    if (Scrimpted) {
        Scrimpted(YES, result, nil);
    }
}

//void sc_evaluate(double db) {
//    if (Scrimpted) {
//        NSNumber *number = [NSNumber numberWithDouble:db];
//        Scrimpted(YES, number, nil);
//    }
//}

bool sc_evaluate_compareson(SCCompareson comparson, double left, double right) {
    switch (comparson) {
        case SCComparesonGreaterThan:
            return left > right;
        break;
        
        case SCComparesonLessThan:
            return left < right;
        break;

        case SCComparesonEqualTo:
            return left == right;
        break;

        case SCComparesonNotEqualTo:
            return left != right;
        break;
        
        case SCComparesonGreatThanOrEqualTo:
            return left >= right;
        break;
        
        case SCComparesonLessThanOrEqualTo:
            return left <= right;
        break;
        
        default:
            return false;
        break;
    }
}

