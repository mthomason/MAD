%{

#import <Foundation/Foundation.h>
#import "MessageBlocks.h"

int yylex(void);
void yyerror(char *s);

%}

%union {
    struct ast                      *a;
    double                          argumentDouble;
    NSInteger                       argumentInteger;
    float                           argumentFloat;
    __unsafe_unretained NSString    *identifier;
}

%token ADD SUBTRACT MULTIPLY DIVIDE
%token END_OF_LINE
%token END_OF_FILE

%token <argumentDouble> DOUBLE
%token <argumentFloat> FLOAT
%token <argumentInteger> INTEGER

%token <identifier> IDENTIFIER

%type <argumentInteger> expression
%type <argumentInteger> number

%destructor { } IDENTIFIER

%left ADD SUBTRACT
%left MULTIPLY DIVIDE

%%


scrimpt : expression

    {
        if (Scrimpted) {
            NSNumber *number = [NSNumber numberWithFloat:$1];
            Scrimpted(YES, number, nil);
        }
    }

expression : number                     { $$ = $1; }
    | expression MULTIPLY expression    { $$ = $1 * $3; }
    | expression DIVIDE expression      { $$ = $1 / $3; }
    | expression ADD expression         { $$ = $1 + $3; }
    | expression SUBTRACT expression    { $$ = $1 - $3; }

number : DOUBLE                         { $$ = $1; }
        | INTEGER                       { $$ = $1; }
        | FLOAT                         { $$ = $1; }
        | IDENTIFIER {
                if ([$1 isEqualToString:@"pi"]) {
                    $$ = M_PI;
                } else {
                    $$ = 0.0;
                }
        }

%%
