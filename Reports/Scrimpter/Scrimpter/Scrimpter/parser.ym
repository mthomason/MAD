%{
    
    #import <Foundation/Foundation.h>
    #import "MessageBlocks.h"
    #import "MADSymbol.h"
    #import "MADSymbolReference.h"
    
    //#define YYDEBUG 0

    int yylex(void);
    void yyerror(char *s, ...);
    void sc_return(id result);
    static bool sc_evaluate_compareson(SCCompareson comparson, double left, double right);
    double sc_control_if(bool expression, double list);
    //MADSymbol *sc_symbolize(NSString *symbol, char *filename, NSInteger flags, NSInteger line, NSInteger column);
    int yydebug = 0;
    

%}

%code requires {
    char *filename;
    
    typedef struct YYLTYPE {
        int first_line;
        int first_column;
        int last_line;
        int last_column;
        char *filename;
    } YYLTYPE;
    # define YYLTYPE_IS_DECLARED 1
    
    # define YYLLOC_DEFAULT(Current, Rhs, N) \
    do	\
        if (N) { \
            (Current).first_line   = YYRHSLOC (Rhs, 1).first_line; \
            (Current).first_column = YYRHSLOC (Rhs, 1).first_column; \
            (Current).last_line    = YYRHSLOC (Rhs, N).last_line; \
            (Current).last_column  = YYRHSLOC (Rhs, N).last_column;	\
            (Current).filename     = YYRHSLOC (Rhs, 1).filename; \
        } else {    /* empty RHS */ \
            (Current).first_line   = (Current).last_line   = YYRHSLOC (Rhs, 0).last_line; \
            (Current).first_column = (Current).last_column = YYRHSLOC (Rhs, 0).last_column;	\
            (Current).filename  = NULL; \
        } \
    while (0)
    
    #define YY_LOCATION_PRINT(File, Loc) \
                fprintf (File, "%d.%d-%d.%d", (Loc).first_line, (Loc).first_column, (Loc).last_line, (Loc).last_column)
}


%union {
    struct ast                                  *a;
    NSInteger                                   fn;
    double                                      d;
    __unsafe_unretained NSNumber                *number;
    bool                                        b;
    __unsafe_unretained MADSymbol               *sym;
    __unsafe_unretained id                      value;
    __unsafe_unretained NSString                *identifier;
}

%locations

%token ADD SUBTRACT MULTIPLY DIVIDE ABSOLUTE_VALUE
%token OPEN_PERN CLOSE_PERN
%token COMMA SIMICOLON
%token <fn> COMPARESON
%token END_OF_LINE
%token END_OF_FILE
%token RETURN
%token VARABLE
%token ASSIGNMENT
%token OPEN_CURLY_BRACKET CLOSE_CURLY_BRACKET

%token IF THEN ELSE WHILE DO LET

%token <d> NUMBER
%token <sym> IDENTIFIER

%type <value> scrimpt
%type <value> statements
%type <value> statement
    //%type <value> matched
    //%type <value> unmatched
%type <value> other_statement
%type <value> result
%type <b> comparson
%type <d> expression
%type <d> factor
%type <d> term

    //%nonassoc THEN
    //%nonassoc ELSE

%%


scrimpt:                                                { sc_return(nil); }
    | result                                            { $$ = $1; sc_return($1); }
    | statements result                                 { $$ = $2; sc_return($2); }
    | statements                                        { $$ = $1; sc_return($1); }
;

statements:                                            
    | statements statement                              { $$ = $2; }
    | statement                                         { $$ = $1; }
;

result:
    | RETURN statement SIMICOLON                        { $$ = $2; }
;

    /*
    statement: matched
    | unmatched
    ;

    matched: other_statement
    | IF expression THEN matched ELSE matched           { $$ = $2 ? $4 : $6; }
    ;

    unmatched: IF expression THEN statement                 { $$ = $2 ? $4 : nil; }
    | IF expression THEN matched ELSE unmatched         { $$ = $2 ? $4 : $6; }
    ;
     */

statement: IF expression OPEN_CURLY_BRACKET statements CLOSE_CURLY_BRACKET  { $$ = $2 ? $4 : nil; }
    | IF expression OPEN_CURLY_BRACKET statements CLOSE_CURLY_BRACKET ELSE OPEN_CURLY_BRACKET statements CLOSE_CURLY_BRACKET  { $$ = $2 ? $4 : $8; }
    | other_statement

other_statement: VARABLE IDENTIFIER ASSIGNMENT expression SIMICOLON { $2.value = [NSNumber numberWithDouble:$4]; $$ = [NSNumber numberWithDouble:$4]; }
    | IDENTIFIER ASSIGNMENT expression SIMICOLON        { $1.value = [NSNumber numberWithDouble:$3]; $$ = [NSNumber numberWithDouble:$3]; }
    | WHILE expression DO statements                    { while ($2) { $$ = $4; } }
    | expression                                        { double d = $1; $$ = [NSNumber numberWithDouble:d]; }
    | SIMICOLON                                         { $$ = nil; }
    | result                                            { $$ = $1; }
;

comparson : expression                                  { $$ = $1; }
;

expression : OPEN_PERN expression CLOSE_PERN            { $$ = $2; }
    | factor                                            { $$ = $1; }
    | expression COMPARESON factor                      { $$ = sc_evaluate_compareson($2, $1, $3); }
    | expression ADD factor                             { $$ = $1 + $3; }
    | expression SUBTRACT factor                        { $$ = $1 - $3; }
;

factor : term                                           { $$ = $1; }
    | factor MULTIPLY term                              { $$ = $1 * $3; }
    | factor DIVIDE term                                { $$ = $1 / $3; }
;

term : NUMBER                                           { $$ = $1; }
    | IDENTIFIER                                        { $$ = [[(MADSymbol *)$1 value] doubleValue]; }
    | ABSOLUTE_VALUE term                               { $$ = $2 > 0 ? $2 : -$2; }
    | SUBTRACT term                                     { $$ = -$2; }
    | OPEN_PERN expression CLOSE_PERN                   { $$ = $2; }
;

%%

    /*MADSymbol *sc_symbolize(NSString *symbol, char *filename, NSInteger flags, NSInteger line, NSInteger column) {
    MADSymbol *s = nil;
    if (ScrimptSymbolReference) {
        NSString *f = [NSString stringWithUTF8String:filename];
        s = ScrimptSymbolReference(symbol, f, flags, line, column);
    }
    return s;
     }*/

void sc_return(id value) {
    if (Scrimpted) {
        Scrimpted(YES, value, nil);
    }
}

static bool sc_evaluate_compareson(SCCompareson comparson, double left, double right) {
    bool evalution;
    switch (comparson) {
        case SCComparesonGreaterThan:
            evalution = left > right;
        break;
        
        case SCComparesonLessThan:
            evalution = left < right;
        break;

        case SCComparesonEqualTo:
            evalution = left == right;
        break;

        case SCComparesonNotEqualTo:
            evalution = left != right;
        break;
        
        case SCComparesonGreatThanOrEqualTo:
            evalution = left >= right;
        break;
        
        case SCComparesonLessThanOrEqualTo:
            evalution = left <= right;
        break;
        
        default:
            evalution = false;
        break;
    }
    return evalution;
}

void
lyyerror(YYLTYPE t, char *s, ...) {
    va_list ap;
    va_start(ap, s);
    if (yylloc.first_line) {
        fprintf(stderr, "%d.%d-%d.%d: error: ", t.first_line, t.first_column, t.last_line, t.last_column);
    }
    vfprintf(stderr, s, ap);
    fprintf(stderr, "\n");
}






















