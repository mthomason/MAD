%{

#import <Foundation/Foundation.h>
#import "MessageBlocks.h"

int yylex(void);
void yyerror(char *s);

%}

%union {
    struct ast                      *a;
    double                          argumentDouble;
    __unsafe_unretained NSString    *identifier;
}

%token ADD SUBTRACT MULTIPLY DIVIDE ABSOLUTE_VALUE
%token END_OF_LINE
%token END_OF_FILE

%token NUMBER
%token IDENTIFIER

%type <argumentDouble> scrimpt
%type <argumentDouble> expression
%type <argumentDouble> factor

%type <argumentDouble> term


%%


scrimpt:
    | scrimpt expression END_OF_LINE   {
        if (Scrimpted) {
            NSNumber *number = [NSNumber numberWithDouble:$2];
            Scrimpted(YES, number, nil);
        }
    }
;

expression : factor                     { $$ = $1; }
    | expression ADD factor             { $$ = $1 + $3; }
    | expression SUBTRACT factor        { $$ = $1 - $3; }
;

factor : term                           { $$ = $1; }
    | factor MULTIPLY term              { $$ = $1 * $3; }
    | factor DIVIDE term                { $$ = $1 / $3; }
;

term : NUMBER
    | ABSOLUTE_VALUE term               { $$ = $2 > 0 ? $2 : -$2; }
;



%%
