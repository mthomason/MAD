%{

#import <Foundation/Foundation.h>
#import "MessageBlocks.h"

#define YYDEBUG 1

int yylex(void);
void yyerror(char *s);
void sc_return(id result);
static bool sc_evaluate_compareson(SCCompareson comparson, double left, double right);
double sc_control_if(bool expression, double list);

int yydebug = 0;

%}

%union {
    struct ast                      *a;
    NSInteger                       fn;
    double                          d;
    bool                            b;
    __unsafe_unretained id          value;
    __unsafe_unretained NSString    *identifier;
}

%token ADD SUBTRACT MULTIPLY DIVIDE ABSOLUTE_VALUE
%token OPEN_PERN CLOSE_PERN
%token COMMA SIMICOLON
%token <fn> COMPARESON
%token END_OF_LINE
%token END_OF_FILE
%token RETURN

%token IF THEN ELSE WHILE DO LET

%token <d> NUMBER
%token IDENTIFIER

%type <value> scrimpt
%type <value> statements
%type <value> statement
%type <value> other_statement
%type <value> result
%type <b> comparson
%type <d> expression
%type <d> factor
%type <d> term

%%


scrimpt:                                                { sc_return(nil); }
    | result                                            { $$ = $1; sc_return($1); }
    | statements result                                 { $$ = $2; sc_return($2); }
    | statements                                        { $$ = $1; sc_return($1); }
;

statements:                                            
    | statements statement                              { $$ = $2; }
    | statement                                         { $$ = $1; }
;

result:
    | RETURN statement SIMICOLON                        {   $$ = $2; }
;

statement: IF expression THEN statement ELSE statement  { $$ = $2 ? $4 : $6; }
    | other_statement
;

other_statement: WHILE expression DO statements         { while ($2) { $$ = $4; } }
    | expression                                        { double d = $1; $$ = [NSNumber numberWithDouble:d]; }
    | SIMICOLON                                         { $$ = nil; }
    | result                                            { $$ = $1; }
;

comparson : expression                                  { $$ = $1; }
;

expression : OPEN_PERN expression CLOSE_PERN            { $$ = $2; }
    | factor                                            { $$ = $1; }
    | expression COMPARESON factor                      { $$ = sc_evaluate_compareson($2, $1, $3); }
    | expression ADD factor                             { $$ = $1 + $3; }
    | expression SUBTRACT factor                        { $$ = $1 - $3; }
;

factor : term                                           { $$ = $1; }
    | factor MULTIPLY term                              { $$ = $1 * $3; }
    | factor DIVIDE term                                { $$ = $1 / $3; }
;

term : NUMBER
    | ABSOLUTE_VALUE term                               { $$ = $2 > 0 ? $2 : -$2; }
    | SUBTRACT term                                     { $$ = -$2; }
    | OPEN_PERN expression CLOSE_PERN                   { $$ = $2; }
;

%%

void sc_return(id value) {
    if (Scrimpted) {
        Scrimpted(YES, value, nil);
    }
}

static bool sc_evaluate_compareson(SCCompareson comparson, double left, double right) {
    bool evalution;
    switch (comparson) {
        case SCComparesonGreaterThan:
            evalution = left > right;
        break;
        
        case SCComparesonLessThan:
            evalution = left < right;
        break;

        case SCComparesonEqualTo:
            evalution = left == right;
        break;

        case SCComparesonNotEqualTo:
            evalution = left != right;
        break;
        
        case SCComparesonGreatThanOrEqualTo:
            evalution = left >= right;
        break;
        
        case SCComparesonLessThanOrEqualTo:
            evalution = left <= right;
        break;
        
        default:
            evalution = false;
        break;
    }
    return evalution;
}
