%{

#import "y.tab.h"
#import "MessageBlocks.h"
    
extern int yylineno;
void yyerror(char *s);

%}

%%

"+"     { return ADD; }
"-"     { return SUBTRACT; }
"*"     { return MULTIPLY; }
"/"     { return DIVIDE; }
"|"     { return ABSOLUTE_VALUE; }
","     { return COMMA; }
";"     { return SIMICOLON; }
"("     { return OPEN_PERN; }
")"     { return CLOSE_PERN; }

">"     { yylval.fn = SCComparesonGreaterThan; return COMPARESON; }
"<"     { yylval.fn = SCComparesonLessThan; return COMPARESON; }
"<>"    { yylval.fn = SCComparesonNotEqualTo; return COMPARESON; }
"=="    { yylval.fn = SCComparesonEqualTo; return COMPARESON; }
">="    { yylval.fn = SCComparesonGreatThanOrEqualTo; return COMPARESON; }
"<="    { yylval.fn = SCComparesonLessThanOrEqualTo; return COMPARESON; }

"if"    { return IF; }
"then"  { return THEN; }
"else"  { return ELSE; }
"while" { return WHILE; }
"do"    { return DO; }
"let"   { return LET;}

[0-9]+\.[0-9]* {
    yylval.d = atof(yytext);
    return NUMBER;
    }

[0-9]+ {
            yylval.d = atof(yytext);
            return NUMBER;
        }

[a-zA-Z]+ {
            yylval.identifier = [NSString stringWithFormat:@"%s", yytext];
            return IDENTIFIER;
        }

"//".*
[\t\n ] { /* Ingnore white space */ }


. { return yytext[0]; };

%%

int yywrap()  {
    return 1;
}

void yyerror(char *s)  {
    
    if (Scrimpted) {
        NSString *display = [NSString stringWithFormat: @"%s at %d", s, yylineno];
        NSError *err = [NSError errorWithDomain: @"Scrimpter"
                                           code: 1
                                       userInfo: @{ NSLocalizedDescriptionKey : display}];
        Scrimpted(NO, nil, err);
    }
}
