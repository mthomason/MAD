%{

#import "y.tab.h"
#import "MessageBlocks.h"
    
void yyerror(char *s);
    
%}

%%

"+" { return ADD; }
"-" { return SUBTRACT; }
"*" { return MULTIPLY; }
"/" { return DIVIDE; }
"|" { return ABSOLUTE_VALUE; }
"(" { return OPEN_PERN; }
")" { return CLOSE_PERN; }

[0-9]+\.[0-9]* {
    yylval.argumentDouble = atof(yytext);
    return NUMBER;
    }

[0-9]+ {
            yylval.argumentDouble = atof(yytext);
            return NUMBER;
        }

[a-zA-Z]+ {
            yylval.identifier = [NSString stringWithFormat:@"%s", yytext];
            return IDENTIFIER;
        }

"//".*
[\t\n ] { /* Ingnore white space */ }


. { return yytext[0]; };

%%

int yywrap()  {
    return 1;
}

void yyerror(char *s)  {
    
    if (Scrimpted) {
        NSString *display = [NSString stringWithFormat: @"%s", s];
        NSError *err = [NSError errorWithDomain: @"Scrimpter"
                                           code: 1
                                       userInfo: @{ NSLocalizedDescriptionKey : display}];
        Scrimpted(NO, nil, err);
    }
}
