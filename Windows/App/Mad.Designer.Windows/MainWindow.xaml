<Window x:Class="Mad.Designer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mad.Designer.Windows.Views"
        xmlns:infra="clr-namespace:Mad.Designer.Windows.Infrastructure"
        Title="{Binding WindowTitle}" Height="800" Width="1320"
        MinHeight="620" MinWidth="1000" WindowStartupLocation="CenterScreen"
        Icon="/Mad.Designer.Windows;component/Assets/AppIcon.png"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="{DynamicResource MAD.FontFamily}"
        FontSize="{DynamicResource MAD.FontSize.Body}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mad.Designer.Windows;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Document.SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding Document.SaveAsCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SelectQueryCommand}" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SelectDesignerCommand}" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SelectViewerCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{DynamicResource ApplicationBackgroundBrush}">
            <MenuItem Header="{infra:Loc Menu.File}">
                <MenuItem Header="{infra:Loc Menu.File.New}" Command="{Binding NewDocumentCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{infra:Loc Menu.File.NewComposition}" Command="{Binding NewCompositionCommand}" />
                <MenuItem Header="{infra:Loc Menu.File.Open}" Command="{Binding OpenDocumentCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="{infra:Loc Menu.File.Convert}" Command="{Binding ConvertCommand}" IsEnabled="{Binding Document.HasDocument}" />
                <MenuItem Header="{infra:Loc Menu.File.Import}" Command="{Binding ImportChildCommand}" />
                <MenuItem Header="{infra:Loc Menu.File.Save}" Command="{Binding Document.SaveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="{infra:Loc Menu.File.SaveAs}" Command="{Binding Document.SaveAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{infra:Loc Menu.File.DatabaseConnection}" Command="{Binding EditConnectionCommand}"
                          IsEnabled="{Binding Document.HasDocument}" />
                <Separator />
                <MenuItem Header="{infra:Loc Menu.File.RecentFiles}" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="{infra:Loc Menu.File.Exit}" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{infra:Loc Menu.Help}">
                <MenuItem Header="{infra:Loc Menu.Help.About}" Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Application-level quick commands. About stays in the Help menu. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource MAD.CommandBar}">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding NewDocumentCommand}"
                            AutomationProperties.Name="{infra:Loc Toolbar.New.Tooltip}"
                            ToolTip="{infra:Loc Toolbar.New.Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Toolbar.New}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding OpenDocumentCommand}" Margin="2,0,0,0"
                            AutomationProperties.Name="{infra:Loc Toolbar.Open.Tooltip}"
                            ToolTip="{infra:Loc Toolbar.Open.Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Toolbar.Open}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource MAD.Divider}" />
                    <TextBlock Text="{Binding Document.FileName}" Style="{StaticResource MAD.SecondaryText}"
                               VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Document.HasDocument, Converter={StaticResource BoolToVis}}" />
                    <Border x:Name="DocumentTypeBadge" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="{Binding Document.DocumentTypeTooltip}"
                            Visibility="{Binding Document.HasDocument, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource MAD.DocumentTypeBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Document.IsComposed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Document.DocumentTypeText}" />
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ProgressBar Width="70" Height="12" IsIndeterminate="{Binding Document.IsBusy}"
                                 Visibility="{Binding Document.IsBusy, Converter={StaticResource BoolToVis}}"
                                 Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Document.StatusText}" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MAD.StatusText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Document.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Document.ErrorText}" MaxWidth="320"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MAD.ErrorText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Document.HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding EditConnectionCommand}"
                            IsEnabled="{Binding Document.HasDocument}" Margin="8,0,0,0"
                            ToolTip="{infra:Loc Viewer.Connection.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Viewer.Connection}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Viewer.Connection}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Primary navigation: three peer-level workspaces, never document tabs. -->
            <Border Style="{StaticResource MAD.NavRail}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{x:Static infra:AppInfo.Version}"
                               Style="{StaticResource MAD.CaptionText}" FontWeight="Normal"
                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <ListBox x:Name="WorkspaceList"
                             SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}"
                             IsEnabled="{Binding HasDocument}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource MAD.NavItem}"
                             VerticalAlignment="Top" Margin="0,14,0,0"
                             AutomationProperties.Name="{infra:Loc Nav.Workspaces}">
                        <ListBoxItem AutomationProperties.Name="{infra:Loc Workspace.Query}">
                            <StackPanel>
                                <TextBlock Text="&#xE721;" Style="{StaticResource MAD.NavIcon}" />
                                <TextBlock Text="{infra:Loc Workspace.Query}" Style="{StaticResource MAD.NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{infra:Loc Workspace.Designer}">
                            <StackPanel>
                                <TextBlock Text="&#xE70F;" Style="{StaticResource MAD.NavIcon}" />
                                <TextBlock Text="{infra:Loc Workspace.Designer}" Style="{StaticResource MAD.NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem AutomationProperties.Name="{infra:Loc Workspace.Viewer}">
                            <StackPanel>
                                <TextBlock Text="&#xE7B3;" Style="{StaticResource MAD.NavIcon}" />
                                <TextBlock Text="{infra:Loc Workspace.Viewer}" Style="{StaticResource MAD.NavLabel}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CompositionColumn" Width="0" />
                    <ColumnDefinition x:Name="CompositionSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="WorkspaceColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Composition pane: the document's graph, always available beside the
                     workspace so a source can be selected without losing the current view. -->
                <Border x:Name="CompositionPane" Grid.Column="0"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        Visibility="{Binding Document.IsComposed, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource MAD.CommandBar}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{infra:Loc Composition.Title}"
                                           Style="{StaticResource MAD.SectionHeader}" Margin="0"
                                           VerticalAlignment="Center" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding ImportChildCommand}"
                                            ToolTip="{infra:Loc Composition.Import.Tooltip}"
                                            AutomationProperties.Name="{infra:Loc Composition.Import}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B5;" Style="{StaticResource MAD.CommandIcon}" />
                                            <TextBlock Text="{infra:Loc Composition.Import}" Style="{StaticResource MAD.CommandLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CompositionExpandButton" Style="{StaticResource MAD.IconButton}"
                                            Margin="2,0,0,0" Click="CompositionExpand_Click"
                                            ToolTip="{Binding Document.Composition.ExpandTooltip}"
                                            AutomationProperties.Name="{Binding Document.Composition.ExpandName}">
                                        <TextBlock Text="{Binding Document.Composition.ExpandGlyph}"
                                                   Style="{StaticResource MAD.CommandIcon}" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <ScrollViewer x:Name="CompositionScroll" Padding="0,8"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding Document.Composition.ShowGraph, Converter={StaticResource BoolToVis}}">
                                <views:CompositionGraphView Composition="{Binding Document.Composition}"
                                                            AutomationProperties.Name="{infra:Loc Composition.Graph.Name}" />
                            </ScrollViewer>
                            <StackPanel x:Name="CompositionEmptyState" Margin="16,20" VerticalAlignment="Top"
                                        Visibility="{Binding Document.Composition.ShowEmptyState, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{infra:Loc Composition.Empty}" Style="{StaticResource MAD.BodyText}" />
                                <Button Style="{StaticResource MAD.PrimaryButton}" Margin="0,14,0,0"
                                        HorizontalAlignment="Left" Command="{Binding ImportChildCommand}"
                                        Content="{infra:Loc Composition.Empty.Import}"
                                        ToolTip="{infra:Loc Composition.Import.Tooltip}"
                                        AutomationProperties.Name="{infra:Loc Composition.Empty.Import}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="CompositionSplitter" Grid.Column="1" Width="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                              Visibility="{Binding Document.IsComposed, Converter={StaticResource BoolToVis}}" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- One picker shared by every workspace and the graph. It stays put when
                         the Composition pane is collapsed, so a source is one click away. -->
                    <Border x:Name="CompositionBar" Grid.Row="0" Style="{StaticResource MAD.CommandBar}"
                            Visibility="{Binding Document.IsComposed, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{infra:Loc Composition.SelectComponent}"
                                       Style="{StaticResource MAD.GroupCaption}" VerticalAlignment="Center" />
                            <ComboBox DockPanel.Dock="Left" MinWidth="180" MaxWidth="280" VerticalAlignment="Center"
                                      ItemsSource="{Binding Document.ComponentOptions}"
                                      SelectedValuePath="Id" SelectedValue="{Binding Document.SelectedQueryId, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      ToolTip="{infra:Loc Composition.SelectComponent.Tooltip}"
                                      AutomationProperties.Name="{infra:Loc Composition.SelectComponent.Name}" />
                            <TextBlock Text="{Binding Document.SelectedQueryHint}" Style="{StaticResource MAD.SecondaryText}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <Border x:Name="SourceWorkspaceNotice" Grid.Row="1"
                            Background="{DynamicResource LayerFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1" Padding="12,6"
                            Visibility="{Binding ShowSourceWorkspaceNotice, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{infra:Loc Composition.WorkspaceNotice}"
                                   Style="{StaticResource MAD.SecondaryText}" />
                    </Border>

                    <Grid Grid.Row="2">
                        <views:QueryView Visibility="{Binding QueryVisible, Converter={StaticResource BoolToVis}}" />
                        <views:DesignerView Visibility="{Binding DesignerVisible, Converter={StaticResource BoolToVis}}" />
                        <views:ViewerView Visibility="{Binding ViewerVisible, Converter={StaticResource BoolToVis}}" />
                        <views:WelcomeView Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
