<Window x:Class="Mad.Designer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mad.Designer.Windows.Views"
        xmlns:infra="clr-namespace:Mad.Designer.Windows.Infrastructure"
        Title="MAD Designer" Height="780" Width="1240"
        MinHeight="620" MinWidth="960">
    <Window.Resources>
        <infra:EnumToIntConverter x:Key="EnumToInt"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Document…" Command="{Binding NewDocumentCommand}"/>
                <MenuItem Header="_Open…" Command="{Binding OpenDocumentCommand}"/>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding Document.SaveCommand}"/>
                <MenuItem Header="Save _As…" Command="{Binding Document.SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="_Database Connection…" Command="{Binding EditConnectionCommand}"
                          IsEnabled="{Binding Document.HasDocument}"/>
                <Separator/>
                <MenuItem Header="_Recent Files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About MAD Designer" Command="{Binding OpenAboutCommand}"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="New…" Command="{Binding NewDocumentCommand}"/>
                <Button Content="Open…" Command="{Binding OpenDocumentCommand}"/>
                <Button Content="About" Command="{Binding OpenAboutCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="90" Height="14"
                                 IsIndeterminate="{Binding Document.IsBusy}"
                                 Visibility="{Binding Document.IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Document.StatusText}" Margin="8,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding Document.ErrorText}" Foreground="Red"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl IsEnabled="{Binding Document.HasDocument}"
                    SelectedIndex="{Binding SelectedWorkspace, Mode=TwoWay, Converter={StaticResource EnumToInt}}">
            <TabItem Header="MAD Query">
                <views:QueryView/>
            </TabItem>
            <TabItem Header="MAD Designer">
                <views:DesignerView/>
            </TabItem>
            <TabItem Header="MAD Viewer">
                <views:ViewerView/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
