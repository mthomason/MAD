<UserControl x:Class="Mad.Designer.Windows.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="The report designer canvas arrives in Phase 6."
                   FontSize="14" Foreground="Gray" Margin="0,0,0,12"/>
        <GroupBox Header="Report columns (from the query)">
            <ListBox ItemsSource="{Binding Document.Columns}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Type}" Foreground="Gray" Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </DockPanel>
</UserControl>
