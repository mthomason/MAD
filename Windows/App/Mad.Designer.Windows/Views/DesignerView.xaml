<UserControl x:Class="Mad.Designer.Windows.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Mad.Designer.Windows.Infrastructure"
             xmlns:views="clr-namespace:Mad.Designer.Windows.Views"
             FontFamily="{DynamicResource MAD.FontFamily}"
             FontSize="{DynamicResource MAD.FontSize.Body}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mad.Designer.Windows;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding Document.Designer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Workspace command bar: insert palette, then edit commands. -->
        <Border Grid.Row="0" Style="{StaticResource MAD.CommandBar}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{infra:Loc Designer.Insert}" Style="{StaticResource MAD.CaptionText}"
                               VerticalAlignment="Center" Margin="2,0,8,0" FontWeight="SemiBold" />
                    <Button Style="{StaticResource MAD.InsertButton}" Command="{Binding AddLabelCommand}"
                            ToolTip="{infra:Loc Designer.Label.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Designer.Label}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D2;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Label}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.InsertButton}" Command="{Binding AddDataFieldCommand}" Margin="2,0,0,0"
                            ToolTip="{infra:Loc Designer.DataField.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Designer.DataField}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.DataField}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.InsertButton}" Command="{Binding AddAggregateCommand}" Margin="2,0,0,0"
                            ToolTip="{infra:Loc Designer.Aggregate.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Designer.Aggregate}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Aggregate}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.InsertButton}" Command="{Binding AddImageCommand}" Margin="2,0,0,0"
                            ToolTip="{infra:Loc Designer.Image.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Designer.Image}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE91B;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Image}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.InsertButton}" Command="{Binding AddLineRuleCommand}" Margin="2,0,0,0"
                            ToolTip="{infra:Loc Designer.Line.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Designer.Line}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE738;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Line}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.InsertButton}" Command="{Binding AddBarcodeCommand}" Margin="2,0,0,0"
                            ToolTip="{infra:Loc Designer.Barcode.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Designer.Barcode}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Barcode}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Border Style="{StaticResource MAD.Divider}" />
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding UndoCommand}"
                            ToolTip="{infra:Loc Designer.Undo.Tooltip}" AutomationProperties.Name="{infra:Loc Designer.Undo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Undo}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding RedoCommand}" Margin="2,0,0,0"
                            ToolTip="{infra:Loc Designer.Redo.Tooltip}" AutomationProperties.Name="{infra:Loc Designer.Redo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A6;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Redo}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding DuplicateElementCommand}" Margin="2,0,0,0"
                            ToolTip="{infra:Loc Designer.Duplicate.Tooltip}" AutomationProperties.Name="{infra:Loc Designer.Duplicate}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Duplicate}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding DeleteElementCommand}" Margin="2,0,0,0"
                            ToolTip="{infra:Loc Designer.Delete.Tooltip}" AutomationProperties.Name="{infra:Loc Designer.Delete}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Designer.Delete}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" MaxWidth="340" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" MinWidth="250" MaxWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Report outline: bands and query fields. -->
            <DockPanel Grid.Column="0" Margin="10,8,10,8">
                <TextBlock DockPanel.Dock="Top" Text="{infra:Loc Designer.Bands}"
                           Style="{StaticResource MAD.SectionHeader}" Margin="0,0,0,4" />
                <ListBox x:Name="SectionsList" DockPanel.Dock="Top" Height="180" Margin="0,0,0,12"
                         ItemsSource="{Binding Sections}" MouseDoubleClick="SectionsList_OnDoubleClick"
                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                         ToolTip="{infra:Loc Designer.Bands.Tooltip}"
                         AutomationProperties.Name="{infra:Loc Designer.Bands.Name}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayTitle}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock DockPanel.Dock="Top" Text="{infra:Loc Designer.QueryFields}"
                           Style="{StaticResource MAD.SectionHeader}" Margin="0,0,0,4" />
                <ListBox x:Name="FieldsList" ItemsSource="{Binding Fields}"
                         MouseDoubleClick="FieldsList_OnDoubleClick"
                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                         ToolTip="{infra:Loc Designer.QueryFields.Tooltip}"
                         AutomationProperties.Name="{infra:Loc Designer.QueryFields.Name}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- The design canvas owns the primary work area. -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <views:DesignerCanvas x:Name="Canvas" ClipToBounds="True" />
            </ScrollViewer>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"
                          Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- Inspector: the minimap is a secondary, collapsible aid, not the first thing seen. -->
            <Border Grid.Column="4" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <StackPanel>
                        <Expander Header="{infra:Loc Designer.Minimap}" IsExpanded="False" Margin="0,0,0,12">
                            <views:DesignerMinimap x:Name="Minimap" Height="118" Margin="0,6,0,0"
                                                   Background="{DynamicResource ControlFillColorDefaultBrush}" />
                        </Expander>

                        <Border Style="{StaticResource MAD.Card}" Margin="0,0,0,12" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{infra:Loc Designer.CardPage}" Style="{StaticResource MAD.SectionHeader}" />
                                <TextBlock Text="{infra:Loc Designer.Paper}" Style="{StaticResource MAD.FieldLabel}" />
                                <ComboBox SelectedIndex="{Binding PaperSizeIndex}" Margin="0,0,0,8"
                                          ToolTip="{infra:Loc Designer.Paper.Tooltip}"
                                          AutomationProperties.Name="{infra:Loc Designer.Paper}">
                                    <ComboBoxItem Content="{infra:Loc Paper.Letter.Display}" />
                                    <ComboBoxItem Content="{infra:Loc Paper.Legal.Display}" />
                                    <ComboBoxItem Content="{infra:Loc Paper.A4.Display}" />
                                </ComboBox>
                                <TextBlock Text="{infra:Loc Designer.Band}" Style="{StaticResource MAD.FieldLabel}" />
                                <TextBlock Text="{Binding SelectedSection.DisplayTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="{infra:Loc Designer.Height}" Style="{StaticResource MAD.FieldLabel}" />
                                <TextBox Text="{Binding SelectedSectionHeight, UpdateSourceTrigger=LostFocus}"
                                         Width="90" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <CheckBox Content="{infra:Loc Designer.SectionVisible}" IsChecked="{Binding SelectedSectionVisible}" Margin="0,0,0,4"
                                          ToolTip="{infra:Loc Designer.SectionVisible.Tooltip}"
                                          AutomationProperties.Name="{infra:Loc Designer.SectionVisible}" />
                                <CheckBox Content="{infra:Loc Designer.PageBreakAfter}" IsChecked="{Binding SelectedSectionPageBreak}"
                                          ToolTip="{infra:Loc Designer.PageBreakAfter.Tooltip}"
                                          AutomationProperties.Name="{infra:Loc Designer.PageBreakAfter}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MAD.Card}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="{infra:Loc Designer.CardElement}" Style="{StaticResource MAD.SectionHeader}" />
                                <TextBlock Text="{infra:Loc Designer.NoSelection}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MAD.SecondaryText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrimaryElement}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrimaryElement}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock Text="{Binding ElementTypeName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,2,0,8" />

                                    <TextBlock Text="{infra:Loc Designer.Band}" Style="{StaticResource MAD.FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Sections}" DisplayMemberPath="DisplayTitle" SelectedValuePath="Id"
                                              SelectedValue="{Binding ElementSectionId}" Margin="0,0,0,8"
                                              ToolTip="{infra:Loc Designer.ElementBand.Tooltip}"
                                              AutomationProperties.Name="{infra:Loc Designer.Band}" />

                                    <TextBlock Text="{infra:Loc Designer.Text}" Style="{StaticResource MAD.FieldLabel}" />
                                    <TextBox Text="{Binding ElementText, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />

                                    <!-- The barcode's content: a static string (the Text box above) or a
                                         query field, plus the symbology and its two options. -->
                                    <StackPanel Margin="0,0,0,8">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrimaryElement.IsBarcode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{infra:Loc Designer.Barcode.Symbology}" Style="{StaticResource MAD.FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding BarcodeTypes}" DisplayMemberPath="Name"
                                                  SelectedIndex="{Binding ElementBarcodeSymbologyIndex}" Margin="0,0,0,8"
                                                  ToolTip="{infra:Loc Designer.Barcode.Symbology.Tooltip}"
                                                  AutomationProperties.Name="{infra:Loc Designer.Barcode.Symbology}" />
                                        <CheckBox Content="{infra:Loc Designer.Barcode.ShowText}"
                                                  IsChecked="{Binding ElementBarcodeHumanReadable}" Margin="0,0,0,8"
                                                  ToolTip="{infra:Loc Designer.Barcode.ShowText.Tooltip}"
                                                  AutomationProperties.Name="{infra:Loc Designer.Barcode.ShowText}" />
                                        <TextBlock Text="{infra:Loc Designer.Barcode.Border}" Style="{StaticResource MAD.FieldLabel}" />
                                        <ComboBox SelectedIndex="{Binding ElementBarcodeBorderIndex}" Margin="0,0,0,8"
                                                  ToolTip="{infra:Loc Designer.Barcode.Border.Tooltip}"
                                                  AutomationProperties.Name="{infra:Loc Designer.Barcode.Border}">
                                            <ComboBoxItem Content="{infra:Loc Designer.Barcode.Border.None}" />
                                            <ComboBoxItem Content="{infra:Loc Designer.Barcode.Border.Bind}" />
                                            <ComboBoxItem Content="{infra:Loc Designer.Barcode.Border.Box}" />
                                        </ComboBox>
                                        <TextBlock Text="{infra:Loc Designer.Barcode.Field}" Style="{StaticResource MAD.FieldLabel}" />
                                        <ComboBox ItemsSource="{Binding BarcodeInputOptions}" DisplayMemberPath="Display"
                                                  SelectedValuePath="Id" SelectedValue="{Binding ElementBarcodeInputId}"
                                                  ToolTip="{infra:Loc Designer.Barcode.Field.Tooltip}"
                                                  AutomationProperties.Name="{infra:Loc Designer.Barcode.Field}" />
                                    </StackPanel>

                                    <!-- The image element's picture. The engine stores PNG
                                         bytes; the picker decodes any chosen PNG/JPEG through
                                         WIC and re-encodes it as PNG before sending it. -->
                                    <StackPanel Margin="0,0,0,8">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrimaryElement.IsImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="{infra:Loc Designer.Image.Choose}" Click="ChooseImage_OnClick"
                                                Style="{StaticResource MAD.CommandButton}" HorizontalAlignment="Left"
                                                ToolTip="{infra:Loc Designer.Image.Choose.Tooltip}"
                                                AutomationProperties.Name="{infra:Loc Designer.Image.Choose}" />
                                    </StackPanel>

                                    <TextBlock Text="{infra:Loc Designer.XY}" Style="{StaticResource MAD.FieldLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding ElementX, UpdateSourceTrigger=LostFocus}" Width="70" />
                                        <TextBlock Text="{infra:Loc Designer.YLabel}" Style="{StaticResource MAD.FieldLabel}" Margin="8,0,4,0" />
                                        <TextBox Text="{Binding ElementY, UpdateSourceTrigger=LostFocus}" Width="70" />
                                    </StackPanel>
                                    <TextBlock Text="{infra:Loc Designer.WH}" Style="{StaticResource MAD.FieldLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding ElementW, UpdateSourceTrigger=LostFocus}" Width="70" />
                                        <TextBlock Text="{infra:Loc Designer.HLabel}" Style="{StaticResource MAD.FieldLabel}" Margin="8,0,4,0" />
                                        <TextBox Text="{Binding ElementH, UpdateSourceTrigger=LostFocus}" Width="70" />
                                    </StackPanel>

                                    <TextBlock Text="{infra:Loc Designer.Typography}" Style="{StaticResource MAD.SectionHeader}" Margin="0,8,0,4" />
                                    <TextBlock Text="{infra:Loc Designer.Font}" Style="{StaticResource MAD.FieldLabel}" />
                                    <TextBox Text="{Binding ElementFontName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                                    <TextBlock Text="{infra:Loc Designer.Size}" Style="{StaticResource MAD.FieldLabel}" />
                                    <TextBox Text="{Binding ElementFontSize, UpdateSourceTrigger=LostFocus}"
                                             Width="90" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <CheckBox Content="B" IsChecked="{Binding ElementBold}" Margin="0,0,10,0"
                                                  ToolTip="{infra:Loc Designer.Bold.Tooltip}"
                                                  AutomationProperties.Name="{infra:Loc Designer.Bold}" />
                                        <CheckBox Content="I" IsChecked="{Binding ElementItalic}" Margin="0,0,10,0"
                                                  ToolTip="{infra:Loc Designer.Italic.Tooltip}"
                                                  AutomationProperties.Name="{infra:Loc Designer.Italic}" />
                                        <CheckBox Content="U" IsChecked="{Binding ElementUnderline}" Margin="0,0,10,0"
                                                  ToolTip="{infra:Loc Designer.Underline.Tooltip}"
                                                  AutomationProperties.Name="{infra:Loc Designer.Underline}" />
                                        <CheckBox Content="S" IsChecked="{Binding ElementStrikethrough}"
                                                  ToolTip="{infra:Loc Designer.Strikethrough.Tooltip}"
                                                  AutomationProperties.Name="{infra:Loc Designer.Strikethrough}" />
                                    </StackPanel>
                                    <TextBlock Text="{infra:Loc Designer.HAlign}" Style="{StaticResource MAD.FieldLabel}" />
                                    <ComboBox SelectedIndex="{Binding ElementHAlignIndex}" Margin="0,0,0,8"
                                              ToolTip="{infra:Loc Designer.HAlign.Tooltip}"
                                              AutomationProperties.Name="{infra:Loc Designer.HAlign.Name}">
                                        <ComboBoxItem Content="{infra:Loc Designer.Align.Left}" />
                                        <ComboBoxItem Content="{infra:Loc Designer.Align.Center}" />
                                        <ComboBoxItem Content="{infra:Loc Designer.Align.Right}" />
                                    </ComboBox>
                                    <TextBlock Text="{infra:Loc Designer.VAlign}" Style="{StaticResource MAD.FieldLabel}" />
                                    <ComboBox SelectedIndex="{Binding ElementVAlignIndex}" Margin="0,0,0,8"
                                              ToolTip="{infra:Loc Designer.VAlign.Tooltip}"
                                              AutomationProperties.Name="{infra:Loc Designer.VAlign.Name}">
                                        <ComboBoxItem Content="{infra:Loc Designer.Align.Top}" />
                                        <ComboBoxItem Content="{infra:Loc Designer.Align.Middle}" />
                                        <ComboBoxItem Content="{infra:Loc Designer.Align.Bottom}" />
                                    </ComboBox>

                                    <TextBlock Text="{infra:Loc Designer.Border}" Style="{StaticResource MAD.FieldLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding ElementBorderTop, UpdateSourceTrigger=LostFocus}" Width="46" />
                                        <TextBox Text="{Binding ElementBorderBottom, UpdateSourceTrigger=LostFocus}" Width="46" Margin="4,0,0,0" />
                                        <TextBox Text="{Binding ElementBorderLeft, UpdateSourceTrigger=LostFocus}" Width="46" Margin="4,0,0,0" />
                                        <TextBox Text="{Binding ElementBorderRight, UpdateSourceTrigger=LostFocus}" Width="46" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{infra:Loc Designer.PadMargin}" Style="{StaticResource MAD.FieldLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding ElementPadding, UpdateSourceTrigger=LostFocus}" Width="70" />
                                        <TextBlock Text="{infra:Loc Designer.MLabel}" Style="{StaticResource MAD.FieldLabel}" Margin="8,0,4,0" />
                                        <TextBox Text="{Binding ElementMargin, UpdateSourceTrigger=LostFocus}" Width="70" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{infra:Loc Designer.Duplicate}" Command="{Binding DuplicateElementCommand}" Margin="0,0,6,0"
                                                ToolTip="{infra:Loc Designer.Duplicate.Tooltip}"
                                                AutomationProperties.Name="{infra:Loc Designer.Duplicate}" />
                                        <Button Content="{infra:Loc Designer.Delete}" Command="{Binding DeleteElementCommand}"
                                                ToolTip="{infra:Loc Designer.Delete.Tooltip}"
                                                AutomationProperties.Name="{infra:Loc Designer.Delete}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Canvas presentation and editing aids live at the bottom, out of the command bar. -->
        <Border Grid.Row="2" Style="{StaticResource MAD.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedSection.DisplayTitle}" Style="{StaticResource MAD.StatusText}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{infra:Loc Designer.Zoom}" Style="{StaticResource MAD.StatusText}" Margin="0,0,6,0" />
                    <Slider Width="130" Minimum="0.5" Maximum="2.5" Value="{Binding Zoom}" VerticalAlignment="Center"
                            TickFrequency="0.25" IsSnapToTickEnabled="True"
                            ToolTip="{infra:Loc Designer.Zoom.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Designer.Zoom}" />
                    <TextBlock Text="{Binding Zoom, StringFormat={}{0:0%}}" Style="{StaticResource MAD.StatusText}"
                               MinWidth="44" TextAlignment="Center" Margin="6,0,0,0" />
                    <Border Style="{StaticResource MAD.Divider}" />
                    <CheckBox Content="{infra:Loc Designer.Grid}" IsChecked="{Binding ShowGrid}" Margin="0,0,10,0"
                              ToolTip="{infra:Loc Designer.Grid.Tooltip}"
                              AutomationProperties.Name="{infra:Loc Designer.Grid}" />
                    <CheckBox Content="{infra:Loc Designer.Snap}" IsChecked="{Binding SnapToGrid}" Margin="0,0,10,0"
                              ToolTip="{infra:Loc Designer.Snap.Tooltip}"
                              AutomationProperties.Name="{infra:Loc Designer.Snap}" />
                    <CheckBox Content="{infra:Loc Designer.Rulers}" IsChecked="{Binding ShowRulers}"
                              ToolTip="{infra:Loc Designer.Rulers.Tooltip}"
                              AutomationProperties.Name="{infra:Loc Designer.Rulers}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
