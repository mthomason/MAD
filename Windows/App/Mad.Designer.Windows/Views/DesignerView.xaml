<UserControl x:Class="Mad.Designer.Windows.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mad.Designer.Windows.Views">
    <Grid DataContext="{Binding Document.Designer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top workspace bar (palette arrives in Phase 6c-ii) -->
        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="8,5">
            <TextBlock Text="Insert:  Label  ·  Data Field  ·  Aggregate  ·  Barcode  ·  Image  ·  Line"
                       Foreground="Gray" FontSize="12"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="340"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260" MinWidth="220" MaxWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="PAGE &amp; SECTION MINIMAP" FontWeight="Bold"
                           Foreground="Gray" FontSize="10" Margin="10,8,10,3"/>
                <Border DockPanel.Dock="Top" Height="124" Background="#F0F0F0" Margin="10,0,10,8"
                        CornerRadius="5">
                    <TextBlock Text="Minimap" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="REPORT BANDS" FontWeight="Bold" Foreground="Gray"
                           FontSize="10" Margin="10,0,10,3"/>
                <ListBox DockPanel.Dock="Top" Height="168" Margin="10,0,10,8" ItemsSource="{Binding Sections}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock DockPanel.Dock="Top" Text="QUERY FIELDS (DRAG TO CANVAS)" FontWeight="Bold"
                           Foreground="Gray" FontSize="10" Margin="10,0,10,3"/>
                <ListBox ItemsSource="{Binding Fields}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Center canvas -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#E8E8E8">
                <views:DesignerCanvas x:Name="Canvas" ClipToBounds="True"/>
            </ScrollViewer>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right inspector -->
            <Border Grid.Column="4" BorderBrush="LightGray" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="1 · PAGE &amp; SELECTED SECTION" FontWeight="Bold" Foreground="Gray" FontSize="10"/>
                        <TextBlock Text="Paper size, section height, visibility and page break."
                                   Foreground="Gray" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <TextBlock Text="2 · SELECTED ELEMENT INSPECTOR" FontWeight="Bold" Foreground="Gray" FontSize="10"/>
                        <TextBlock Text="No element selected." Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
