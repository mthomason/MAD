<UserControl x:Class="Mad.Designer.Windows.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Mad.Designer.Windows.Views">
    <Grid DataContext="{Binding Document.Designer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top workspace bar: element palette -->
        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Insert:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="Label" Command="{Binding AddLabelCommand}" Margin="0,0,4,0"/>
                <Button Content="Data Field" Command="{Binding AddDataFieldCommand}" Margin="0,0,4,0"/>
                <Button Content="Aggregate" Command="{Binding AddAggregateCommand}" Margin="0,0,4,0"/>
                <Button Content="Barcode" IsEnabled="False" Margin="0,0,4,0"
                        ToolTip="Barcode is not available in the Windows engine"/>
                <Button Content="Image" Command="{Binding AddImageCommand}" Margin="0,0,4,0"/>
                <Button Content="Line" Command="{Binding AddLineRuleCommand}" Margin="0,0,4,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="340"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260" MinWidth="220" MaxWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="PAGE &amp; SECTION MINIMAP" FontWeight="Bold"
                           Foreground="Gray" FontSize="10" Margin="10,8,10,3"/>
                <views:DesignerMinimap x:Name="Minimap" DockPanel.Dock="Top" Height="124"
                                        Margin="10,0,10,8" Background="#F0F0F0"/>
                <TextBlock DockPanel.Dock="Top" Text="REPORT BANDS" FontWeight="Bold" Foreground="Gray"
                           FontSize="10" Margin="10,0,10,3"/>
                <ListBox x:Name="SectionsList" DockPanel.Dock="Top" Height="168" Margin="10,0,10,8"
                         ItemsSource="{Binding Sections}" MouseDoubleClick="SectionsList_OnDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock DockPanel.Dock="Top" Text="QUERY FIELDS (DRAG TO CANVAS)" FontWeight="Bold"
                           Foreground="Gray" FontSize="10" Margin="10,0,10,3"/>
                <ListBox x:Name="FieldsList" ItemsSource="{Binding Fields}"
                         MouseDoubleClick="FieldsList_OnDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Center canvas -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#E8E8E8">
                <views:DesignerCanvas x:Name="Canvas" ClipToBounds="True"/>
            </ScrollViewer>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right inspector -->
            <Border Grid.Column="4" BorderBrush="LightGray" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- Card 1: page & selected section -->
                        <TextBlock Text="1 · PAGE &amp; SELECTED SECTION" FontWeight="Bold" Foreground="Gray" FontSize="10"/>
                        <TextBlock Text="Paper" Foreground="Gray" FontSize="11" Margin="0,6,0,2"/>
                        <ComboBox SelectedIndex="{Binding PaperSizeIndex}" Margin="0,0,0,8">
                            <ComboBoxItem Content="US Letter (8.5 × 11 in)"/>
                            <ComboBoxItem Content="US Legal (8.5 × 14 in)"/>
                            <ComboBoxItem Content="A4 (210 × 297 mm)"/>
                        </ComboBox>
                        <TextBlock Text="Band" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedSection.Title}" FontWeight="SemiBold"
                                   Foreground="#0A84FF" Margin="0,0,0,8"/>
                        <TextBlock Text="Height (pt)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedSectionHeight, UpdateSourceTrigger=LostFocus}"
                                 Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <CheckBox Content="Section Visible" IsChecked="{Binding SelectedSectionVisible}" Margin="0,0,0,4"/>
                        <CheckBox Content="Page Break After" IsChecked="{Binding SelectedSectionPageBreak}" Margin="0,0,0,8"/>

                        <Separator Margin="0,6"/>

                        <!-- Card 2: selected element -->
                        <TextBlock Text="2 · SELECTED ELEMENT INSPECTOR" FontWeight="Bold" Foreground="Black" FontSize="10"/>
                        <TextBlock Text="{Binding ElementTypeName}" FontWeight="SemiBold"
                                   Foreground="#0A84FF" Margin="0,4,0,8"/>

                        <TextBlock Text="Band" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Sections}" DisplayMemberPath="Title" SelectedValuePath="Id"
                                  SelectedValue="{Binding ElementSectionId}" Margin="0,0,0,8"/>

                        <TextBlock Text="Text" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ElementText, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>

                        <TextBlock Text="X / Y (pt)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding ElementX, UpdateSourceTrigger=LostFocus}" Width="64"/>
                            <TextBlock Text="  Y:" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ElementY, UpdateSourceTrigger=LostFocus}" Width="64"/>
                        </StackPanel>
                        <TextBlock Text="W / H (pt)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding ElementW, UpdateSourceTrigger=LostFocus}" Width="64"/>
                            <TextBlock Text="  H:" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ElementH, UpdateSourceTrigger=LostFocus}" Width="64"/>
                        </StackPanel>

                        <TextBlock Text="TYPOGRAPHY" FontWeight="Bold" Foreground="Gray" FontSize="10" Margin="0,6,0,2"/>
                        <TextBlock Text="Font" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ElementFontName, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"/>
                        <TextBlock Text="Size (pt)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ElementFontSize, UpdateSourceTrigger=LostFocus}"
                                 Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="B" IsChecked="{Binding ElementBold}" Margin="0,0,8,0"/>
                            <CheckBox Content="I" IsChecked="{Binding ElementItalic}" Margin="0,0,8,0"/>
                            <CheckBox Content="U" IsChecked="{Binding ElementUnderline}" Margin="0,0,8,0"/>
                            <CheckBox Content="S" IsChecked="{Binding ElementStrikethrough}"/>
                        </StackPanel>
                        <TextBlock Text="H-Align" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox SelectedIndex="{Binding ElementHAlignIndex}" Margin="0,0,0,8">
                            <ComboBoxItem Content="Left"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Right"/>
                        </ComboBox>
                        <TextBlock Text="V-Align" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox SelectedIndex="{Binding ElementVAlignIndex}" Margin="0,0,0,8">
                            <ComboBoxItem Content="Top"/><ComboBoxItem Content="Middle"/><ComboBoxItem Content="Bottom"/>
                        </ComboBox>

                        <TextBlock Text="Border T / B / L / R (pt)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding ElementBorderTop, UpdateSourceTrigger=LostFocus}" Width="42"/>
                            <TextBox Text="{Binding ElementBorderBottom, UpdateSourceTrigger=LostFocus}" Width="42"/>
                            <TextBox Text="{Binding ElementBorderLeft, UpdateSourceTrigger=LostFocus}" Width="42"/>
                            <TextBox Text="{Binding ElementBorderRight, UpdateSourceTrigger=LostFocus}" Width="42"/>
                        </StackPanel>
                        <TextBlock Text="Pad / Margin (pt)" Foreground="Gray" FontSize="11" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding ElementPadding, UpdateSourceTrigger=LostFocus}" Width="64"/>
                            <TextBlock Text="  M:" Foreground="Gray" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ElementMargin, UpdateSourceTrigger=LostFocus}" Width="64"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Duplicate" Command="{Binding DuplicateElementCommand}" Margin="0,0,6,0"/>
                            <Button Content="Delete" Command="{Binding DeleteElementCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
