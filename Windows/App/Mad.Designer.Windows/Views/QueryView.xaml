<UserControl x:Class="Mad.Designer.Windows.Views.QueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Database schema" FontWeight="Bold" Margin="0,0,0,4"/>
            <TreeView ItemsSource="{Binding Document.Tables}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Fields}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Type}" Foreground="Gray" Margin="8,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Generated SQL" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Document.Sql}" IsReadOnly="True" FontFamily="Consolas"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</UserControl>
