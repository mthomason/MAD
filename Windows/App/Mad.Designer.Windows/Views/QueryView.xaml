<UserControl x:Class="Mad.Designer.Windows.Views.QueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Mad.Designer.Windows.Infrastructure"
             xmlns:views="clr-namespace:Mad.Designer.Windows.Views"
             FontFamily="{DynamicResource MAD.FontFamily}"
             FontSize="{DynamicResource MAD.FontSize.Body}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mad.Designer.Windows;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid DataContext="{Binding Document.Query}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Workspace command bar: a local Designer/SQL mode switch, then its command groups. -->
        <Border Grid.Row="0" Style="{StaticResource MAD.CommandBar}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Style="{StaticResource MAD.SegmentedHost}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Style="{StaticResource MAD.SegmentToggle}"
                                      Content="{infra:Loc Query.Mode.Designer}"
                                      IsChecked="{Binding DesignerSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{infra:Loc Query.Mode.Designer}" />
                        <ToggleButton Style="{StaticResource MAD.SegmentToggle}" Margin="2,0,0,0"
                                      Content="{infra:Loc Query.Mode.Sql}"
                                      IsChecked="{Binding SqlSelected, Mode=TwoWay}"
                                      AutomationProperties.Name="{infra:Loc Query.Mode.Sql}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MAD.Divider}" />

                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDesigner, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="FiltersButton" Style="{StaticResource MAD.CommandButton}" Click="ToggleFilters">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{Binding FiltersLabel}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="GroupsButton" Style="{StaticResource MAD.CommandButton}" Margin="2,0,0,0" Click="ToggleGroups">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EF;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{Binding GroupsLabel}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource MAD.Divider}" />
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding ArrangeTablesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Query.ArrangeTables}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Visibility="{Binding IsSql, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding RevertSqlCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Query.RevertSql}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding ValidateSqlCommand}" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Query.ValidateSql}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.CommandButton}" Command="{Binding CompileAndApplySqlCommand}" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FB;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Query.ApplySql}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Visual query designer: schema list + zoomable canvas -->
        <Grid Grid.Row="1" Visibility="{Binding IsDesigner, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="170" MaxWidth="420" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="10,8,10,8">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{infra:Loc Query.DatabaseTables}"
                               Style="{StaticResource MAD.SectionHeader}"
                               VerticalAlignment="Center" Margin="0" />
                    <Button Grid.Column="1" Style="{StaticResource MAD.CommandButton}"
                            Command="{Binding AddTableCommand}"
                            CommandParameter="{Binding SelectedItem.Name, ElementName=SchemaList}"
                            ToolTip="{infra:Loc Query.AddTable}"
                            AutomationProperties.Name="{infra:Loc Query.AddTable}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource MAD.CommandIcon}" FontSize="14" />
                            <TextBlock Text="{infra:Loc Query.AddTable}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListBox x:Name="SchemaList" ItemsSource="{Binding SchemaTables}"
                         MouseDoubleClick="SchemaList_OnDoubleClick"
                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                         BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ({1})">
                                        <Binding Path="Name" />
                                        <Binding Path="Fields.Count" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <ScrollViewer x:Name="CanvasScroll" Grid.Column="2"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <views:QueryCanvas x:Name="Canvas" ClipToBounds="True" />
            </ScrollViewer>
        </Grid>

        <!-- SQL Query editor -->
        <Grid Grid.Row="1" Margin="16" Visibility="{Binding IsSql, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{infra:Loc Query.SqlStatement}"
                       Style="{StaticResource MAD.SectionHeader}"
                       FontSize="{StaticResource MAD.FontSize.Secondary}" />
            <TextBox Grid.Row="1" Text="{Binding SqlEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Cascadia Mono, Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="10" VerticalContentAlignment="Top"
                     Background="{DynamicResource ControlFillColorDefaultBrush}" />
        </Grid>

        <!-- Status and canvas-view bar -->
        <Border Grid.Row="2" Style="{StaticResource MAD.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MAD.StatusText}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource MAD.IconButton}"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip="{infra:Loc Query.ZoomOut.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Query.ZoomOut.Tooltip}"
                            Content="−" FontSize="16" />
                    <TextBlock x:Name="ZoomLabel" Text="{Binding ZoomText}" Style="{StaticResource MAD.StatusText}"
                               MinWidth="48" TextAlignment="Center" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource MAD.IconButton}"
                            Command="{Binding ZoomInCommand}"
                            ToolTip="{infra:Loc Query.ZoomIn.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Query.ZoomIn.Tooltip}"
                            Content="+" FontSize="16" />
                    <Button x:Name="FitButton" Style="{StaticResource MAD.CommandButton}" Margin="6,0,0,0"
                            Command="{Binding FitCommand}"
                            ToolTip="{infra:Loc Query.ZoomFit.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Query.ZoomFit.Tooltip}">
                        <TextBlock Text="{infra:Loc Query.ZoomFit}" Style="{StaticResource MAD.CommandLabel}" Margin="0" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters (WHERE) editor popover -->
        <Popup x:Name="FiltersPopup" Placement="Bottom" StaysOpen="False"
               PlacementTarget="{Binding ElementName=FiltersButton, Mode=OneWay}" AllowsTransparency="True">
            <Border Style="{StaticResource MAD.PopupSurface}" MinWidth="460">
                <StackPanel>
                    <TextBlock Text="{infra:Loc Query.ActiveFilters}" Style="{StaticResource MAD.SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding PredicateRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="−" Margin="6,0,0,0" Padding="4,0"
                                            Style="{StaticResource MAD.IconButton}" Width="26" Height="24"
                                            Command="{Binding DataContext.RemovePredicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Id}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ComboBox Width="160" ItemsSource="{Binding AllFields}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedFilterField}" />
                        <ComboBox Width="60" Margin="6,0,0,0" ItemsSource="{Binding FilterOperatorSymbols}"
                                  SelectedIndex="{Binding SelectedFilterOperatorIndex, Mode=TwoWay}" />
                        <TextBox Width="120" Margin="6,0,0,0" Text="{Binding FilterValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{infra:Loc Query.Add}" Margin="6,0,0,0" Command="{Binding AddPredicateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Groupings (GROUP BY) editor popover -->
        <Popup x:Name="GroupsPopup" Placement="Bottom" StaysOpen="False"
               PlacementTarget="{Binding ElementName=GroupsButton, Mode=OneWay}" AllowsTransparency="True">
            <Border Style="{StaticResource MAD.PopupSurface}" MinWidth="430">
                <StackPanel>
                    <TextBlock Text="{infra:Loc Query.GroupingLevels}" Style="{StaticResource MAD.SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding GroupRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="−" Margin="6,0,0,0" Padding="4,0"
                                            Style="{StaticResource MAD.IconButton}" Width="26" Height="24"
                                            Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Id}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ComboBox Width="190" ItemsSource="{Binding AllFields}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedGroupField}" />
                        <ComboBox Width="120" Margin="6,0,0,0" ItemsSource="{Binding GroupSortLabels}"
                                  SelectedIndex="{Binding SelectedGroupSortIndex, Mode=TwoWay}" />
                        <Button Content="{infra:Loc Query.AddGroup}" Margin="6,0,0,0" Command="{Binding AddGroupCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
