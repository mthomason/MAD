<UserControl x:Class="Mad.Designer.Windows.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Mad.Designer.Windows.Infrastructure"
             xmlns:vm="clr-namespace:Mad.Designer.Windows.ViewModels"
             FontFamily="{DynamicResource MAD.FontFamily}"
             FontSize="{DynamicResource MAD.FontSize.Body}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mad.Designer.Windows;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding Document.Viewer.PrintCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Commands: document actions, page size, then output. View controls are below. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource MAD.CommandBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource MAD.CommandButton}"
                            Command="{Binding Document.Viewer.RefreshCommand}"
                            ToolTip="{infra:Loc Viewer.Refresh.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Viewer.Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Viewer.Refresh}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MAD.CommandButton}" Margin="2,0,0,0"
                            Command="{Binding EditConnectionCommand}"
                            ToolTip="{infra:Loc Viewer.Connection.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Viewer.Connection}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Viewer.Connection}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource MAD.Divider}" />
                    <TextBlock Text="{infra:Loc Viewer.PageSize}" Style="{StaticResource MAD.SecondaryText}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="PageSizeBox" Width="200" VerticalAlignment="Center"
                              ItemsSource="{x:Static vm:ViewerViewModel.PaperOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedIndex="{Binding Document.Viewer.SelectedPaperIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{infra:Loc Viewer.PageSize}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrintButton" Style="{StaticResource MAD.CommandButton}"
                            Command="{Binding Document.Viewer.PrintCommand}"
                            ToolTip="{infra:Loc Viewer.Print}"
                            AutomationProperties.Name="{infra:Loc Viewer.Print}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Viewer.Print}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="FormatBox" Width="210" Margin="6,0,0,0" VerticalAlignment="Center"
                              ItemsSource="{x:Static vm:ViewerViewModel.ExportFormats}"
                              DisplayMemberPath="Title"
                              SelectedIndex="{Binding Document.Viewer.SelectedFormatIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{infra:Loc Viewer.Export}" />
                    <Button x:Name="ExportButton" Style="{StaticResource MAD.CommandButton}" Margin="6,0,0,0"
                            Command="{Binding Document.Viewer.ExportCommand}"
                            ToolTip="{infra:Loc Viewer.Export}"
                            AutomationProperties.Name="{infra:Loc Viewer.Export}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource MAD.CommandIcon}" />
                            <TextBlock Text="{infra:Loc Viewer.Export}" Style="{StaticResource MAD.CommandLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- View and status bar: zoom and page navigation, leaving the report the most area. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource MAD.StatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ProgressBar Width="90" Height="12" IsIndeterminate="True"
                                 Visibility="{Binding Document.IsBusyOrExporting, Converter={StaticResource BoolToVis}}"
                                 Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="{Binding Document.Viewer.StatusText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MAD.StatusText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Document.Viewer.StatusKind}" Value="Success">
                                        <Setter Property="Foreground" Value="{StaticResource MAD.SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Document.Viewer.StatusKind}" Value="Error">
                                        <Setter Property="Foreground" Value="{StaticResource MAD.ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="−" Style="{StaticResource MAD.IconButton}"
                            Command="{Binding Document.Viewer.ZoomOutCommand}"
                            ToolTip="{infra:Loc Viewer.ZoomOut.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Viewer.ZoomOut.Tooltip}" FontSize="16" />
                    <Button x:Name="ZoomLabel" Content="{Binding Document.Viewer.ZoomText}"
                            Style="{StaticResource MAD.CommandButton}" MinWidth="54"
                            Command="{Binding Document.Viewer.ResetZoomCommand}"
                            ToolTip="{infra:Loc Viewer.ZoomReset.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Viewer.ZoomReset.Tooltip}" />
                    <Button Content="+" Style="{StaticResource MAD.IconButton}"
                            Command="{Binding Document.Viewer.ZoomInCommand}"
                            ToolTip="{infra:Loc Viewer.ZoomIn.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Viewer.ZoomIn.Tooltip}" FontSize="16" />
                    <Border Style="{StaticResource MAD.Divider}" />
                    <Button Content="◀" Style="{StaticResource MAD.IconButton}"
                            Command="{Binding Document.Viewer.PreviousPageCommand}"
                            ToolTip="{infra:Loc Viewer.PreviousPage.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Viewer.PreviousPage.Tooltip}" FontSize="11" />
                    <TextBlock x:Name="PageLabelText" Text="{Binding Document.Viewer.PageLabel}"
                               Style="{StaticResource MAD.StatusText}" TextAlignment="Center"
                               MinWidth="92" Margin="6,0" />
                    <Button Content="▶" Style="{StaticResource MAD.IconButton}"
                            Command="{Binding Document.Viewer.NextPageCommand}"
                            ToolTip="{infra:Loc Viewer.NextPage.Tooltip}"
                            AutomationProperties.Name="{infra:Loc Viewer.NextPage.Tooltip}" FontSize="11" />
                    <Border Style="{StaticResource MAD.Divider}" />
                    <TextBlock x:Name="PaperStatusText" Text="{Binding Document.Viewer.PaperStatusText}"
                               Style="{StaticResource MAD.StatusText}" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The rendered report. The WebView2 is created when this view is visible with a
             document open, so the XAML itself materialises without a browser (the headless
             visual tests rely on that) and the Welcome screen is never covered. -->
        <Grid x:Name="PreviewHost" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" ClipToBounds="True">
            <TextBlock x:Name="Placeholder" Text="{infra:Loc Viewer.Placeholder}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MAD.SecondaryText}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Document.Viewer.PreviewHtml}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
