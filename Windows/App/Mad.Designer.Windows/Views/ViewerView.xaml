<UserControl x:Class="Mad.Designer.Windows.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Mad.Designer.Windows.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Top toolbar: page size, refresh, connection; zoom and page navigation; print and export -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                Background="#F7F7F7" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Page Size:" VerticalAlignment="Center" Foreground="#555555" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PageSizeBox" Width="190"
                              ItemsSource="{x:Static vm:ViewerViewModel.PaperOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedIndex="{Binding Document.Viewer.SelectedPaperIndex, Mode=TwoWay}"/>
                    <Button Content="Refresh" Command="{Binding Document.Viewer.RefreshCommand}"
                            Padding="10,2" Margin="8,0,0,0"
                            ToolTip="Re-run the query and re-render the report"/>
                    <Button Content="Connection…" Command="{Binding EditConnectionCommand}"
                            Padding="10,2" Margin="8,0,0,0"
                            ToolTip="Configure Database Connection Settings…"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="−" Command="{Binding Document.Viewer.ZoomOutCommand}"
                            MinWidth="28" ToolTip="Zoom Out"/>
                    <Button x:Name="ZoomLabel" Content="{Binding Document.Viewer.ZoomText}"
                            Command="{Binding Document.Viewer.ResetZoomCommand}"
                            MinWidth="52" Margin="4,0"
                            ToolTip="Reset Zoom to 100% (Actual Page Size)"/>
                    <Button Content="+" Command="{Binding Document.Viewer.ZoomInCommand}"
                            MinWidth="28" Margin="0,0,12,0" ToolTip="Zoom In"/>
                    <Button Content="◀" Command="{Binding Document.Viewer.PreviousPageCommand}"
                            MinWidth="28" ToolTip="Previous Page"/>
                    <TextBlock x:Name="PageLabelText" Text="{Binding Document.Viewer.PageLabel}"
                               VerticalAlignment="Center" TextAlignment="Center"
                               MinWidth="82" Margin="8,0" Foreground="#555555"/>
                    <Button Content="▶" Command="{Binding Document.Viewer.NextPageCommand}"
                            MinWidth="28" ToolTip="Next Page"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PrintButton" Content="Print…"
                            Command="{Binding Document.Viewer.PrintCommand}" Padding="10,2"/>
                    <ComboBox x:Name="FormatBox" Width="190" Margin="8,0"
                              ItemsSource="{x:Static vm:ViewerViewModel.ExportFormats}"
                              DisplayMemberPath="Title"
                              SelectedIndex="{Binding Document.Viewer.SelectedFormatIndex, Mode=TwoWay}"/>
                    <Button x:Name="ExportButton" Content="Export…"
                            Command="{Binding Document.Viewer.ExportCommand}" Padding="10,2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom status bar: progress, the status line, and the rendered paper size -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                Background="#F7F7F7" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ProgressBar Width="90" Height="14" IsIndeterminate="True"
                                 Visibility="{Binding Document.IsBusy, Converter={StaticResource BoolToVis}}"
                                 Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="{Binding Document.Viewer.StatusText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#666666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Document.Viewer.StatusKind}" Value="Success">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Document.Viewer.StatusKind}" Value="Error">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="PaperStatusText" Grid.Column="1"
                           Text="{Binding Document.Viewer.PaperStatusText}"
                           VerticalAlignment="Center" Foreground="#555555"/>
            </Grid>
        </Border>

        <!-- The rendered report. The WebView2 is created here on Load, so the XAML itself
             materialises without a browser (the headless visual tests rely on that). -->
        <Grid x:Name="PreviewHost" Background="#E8E8E8" ClipToBounds="True">
            <TextBlock x:Name="Placeholder" Text="Refresh to render the report."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#777777" FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Document.Viewer.PreviewHtml}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
