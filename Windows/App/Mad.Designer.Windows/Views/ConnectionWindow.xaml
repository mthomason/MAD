<Window x:Class="Mad.Designer.Windows.Views.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Mad.Designer.Windows.Infrastructure"
        Title="{infra:Loc Connection.Title.Edit}" Width="640" Height="660"
        MinWidth="580" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Icon="/Mad.Designer.Windows;component/Assets/AppIcon.png"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="{DynamicResource MAD.FontFamily}"
        FontSize="{DynamicResource MAD.FontSize.Body}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mad.Designer.Windows;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <infra:EnumToIntConverter x:Key="EnumToInt" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource MAD.Card}" Margin="0,0,0,12" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{infra:Loc Connection.Section.Connection}" Style="{StaticResource MAD.SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{infra:Loc Connection.Driver}" Style="{StaticResource MAD.FieldLabel}" />
                            <ComboBox Grid.Column="1" x:Name="DriverCombo" Margin="0,2,0,4"
                                      SelectedIndex="{Binding Driver, Mode=TwoWay, Converter={StaticResource EnumToInt}}">
                                <ComboBoxItem Content="{infra:Loc Driver.Sqlite}" />
                                <ComboBoxItem Content="{infra:Loc Driver.MySql}" />
                                <ComboBoxItem Content="{infra:Loc Driver.SqlServer}" />
                                <ComboBoxItem Content="{infra:Loc Driver.Postgres}" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MAD.Card}" Margin="0,0,0,12" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- SQLite -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{infra:Loc Connection.File}"
                                   Style="{StaticResource MAD.FieldLabel}"
                                   Visibility="{Binding IsSqlite, Converter={StaticResource BoolToVis}}" />
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,2,0,8"
                              Visibility="{Binding IsSqlite, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding File, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="{infra:Loc Connection.ChooseFile}" Margin="8,0,0,0"
                                    Click="ChooseFile_Click" />
                        </Grid>

                        <!-- Server -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{infra:Loc Connection.Host}"
                                   Style="{StaticResource MAD.FieldLabel}"
                                   Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,8"
                                 Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{infra:Loc Connection.Port}"
                                   Style="{StaticResource MAD.FieldLabel}"
                                   Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,8" Text="{Binding Port}"
                                 Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{infra:Loc Connection.ServerInstance}"
                                   Style="{StaticResource MAD.FieldLabel}"
                                   Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2,0,8"
                                 Text="{Binding ServerInstance, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{infra:Loc Connection.Database}"
                                   Style="{StaticResource MAD.FieldLabel}"
                                   Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2,0,8"
                                 Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource MAD.Card}" Margin="0,0,0,12" Padding="16,12"
                        Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{infra:Loc Connection.Section.Credentials}" Style="{StaticResource MAD.SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{infra:Loc Connection.Username}"
                                       Style="{StaticResource MAD.FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,8"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{infra:Loc Connection.Password}"
                                       Style="{StaticResource MAD.FieldLabel}" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Margin="0,2,0,8"
                                         PasswordChanged="PasswordBox_PasswordChanged" />

                            <CheckBox Grid.Row="2" Grid.Column="1" Content="{infra:Loc Connection.SavePassword}"
                                      IsChecked="{Binding SaveCredentials}" Margin="0,2,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Style="{StaticResource MAD.SecondaryText}" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{infra:Loc Connection.Test}" Command="{Binding TestConnectionCommand}" MinWidth="120" />
                <Button x:Name="SubmitButton" Style="{StaticResource MAD.PrimaryButton}"
                        Content="{infra:Loc Connection.Create}" Command="{Binding SubmitCommand}"
                        MinWidth="150" Margin="8,0,0,0" />
                <Button Content="{infra:Loc Connection.Cancel}" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
