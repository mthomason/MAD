<Window x:Class="Mad.Designer.Windows.Views.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Mad.Designer.Windows.Infrastructure"
        Title="{infra:Loc Connection.Title.Edit}" Width="560"
        SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <infra:EnumToIntConverter x:Key="EnumToInt"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="{infra:Loc Connection.Driver}" FontWeight="SemiBold"/>
        <ComboBox x:Name="DriverCombo" Margin="0,4,0,12"
                  SelectedIndex="{Binding Driver, Mode=TwoWay, Converter={StaticResource EnumToInt}}">
            <ComboBoxItem Content="{infra:Loc Driver.Sqlite}"/>
            <ComboBoxItem Content="{infra:Loc Driver.MySql}"/>
            <ComboBoxItem Content="{infra:Loc Driver.SqlServer}"/>
            <ComboBoxItem Content="{infra:Loc Driver.Postgres}"/>
        </ComboBox>

        <!-- SQLite -->
        <StackPanel Visibility="{Binding IsSqlite, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{infra:Loc Connection.File}" FontWeight="SemiBold"/>
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding File, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="{infra:Loc Connection.ChooseFile}" Margin="8,0,0,0" Padding="10,2" Click="ChooseFile_Click"/>
            </Grid>
        </StackPanel>

        <!-- Server drivers -->
        <StackPanel Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{infra:Loc Connection.Host}" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

            <TextBlock Text="{infra:Loc Connection.Port}" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Port}" Margin="0,4,0,8"/>

            <TextBlock Text="{infra:Loc Connection.ServerInstance}" FontWeight="SemiBold"
                       Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}"/>
            <TextBox Text="{Binding ServerInstance, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsSqlServer, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8"/>

            <TextBlock Text="{infra:Loc Connection.Database}" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

            <TextBlock Text="{infra:Loc Connection.Username}" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>

            <TextBlock Text="{infra:Loc Connection.Password}" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" Margin="0,4,0,8"/>

            <CheckBox Content="{infra:Loc Connection.SavePassword}"
                      IsChecked="{Binding SaveCredentials}" Margin="0,0,0,8"/>
        </StackPanel>

        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="Gray" MinHeight="34"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{infra:Loc Connection.Test}" Command="{Binding TestConnectionCommand}" Width="120" Padding="10,2"/>
            <Button x:Name="SubmitButton" Content="{infra:Loc Connection.Create}" Command="{Binding SubmitCommand}" Width="140" Padding="10,2" Margin="8,0,0,0"/>
            <Button Content="{infra:Loc Connection.Cancel}" IsCancel="True" Width="80" Padding="10,2" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
