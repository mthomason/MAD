<Window x:Class="Mad.Designer.Windows.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About MAD Designer" Height="620" Width="760"
        MinHeight="480" MinWidth="640" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8">
            <TextBlock Text="MAD Designer" FontSize="20" FontWeight="Bold" Foreground="#CC2922"/>
            <TextBlock Text="{Binding Version}" FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
            <TextBlock Text="{Binding Copyright}" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
        </StackPanel>

        <TabControl Margin="12,0,12,12">
            <TabItem Header="Overview">
                <TextBox Text="{Binding Overview}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontSize="12" Margin="4"/>
            </TabItem>
            <TabItem Header="License &amp; Notice">
                <TextBox Text="{Binding LicenseNotice}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="4"/>
            </TabItem>
            <TabItem Header="Acknowledgements">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding Components}"
                             SelectedItem="{Binding SelectedComponent}"
                             DisplayMemberPath="Name"/>
                    <TextBox Grid.Column="1" Text="{Binding SelectedAcknowledgement}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Margin="8,0,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
