<Window x:Class="Mad.Designer.Windows.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Mad.Designer.Windows.Infrastructure"
        Title="{infra:Loc About.Title}" Height="640" Width="800"
        MinHeight="520" MinWidth="680" WindowStartupLocation="CenterOwner"
        Icon="/Mad.Designer.Windows;component/Assets/AppIcon.png"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="{DynamicResource MAD.FontFamily}"
        FontSize="{DynamicResource MAD.FontSize.Body}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Mad.Designer.Windows;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="24,20,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/Mad.Designer.Windows;component/Assets/AppIcon.png" Width="56" Height="56"
                   VerticalAlignment="Top" AutomationProperties.Name="{infra:Loc App.Title}" />
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{infra:Loc App.Title}" Style="{StaticResource MAD.TitleText}" />
                <TextBlock Text="{Binding ApplicationVersion, StringFormat={}{0}}"
                           Style="{StaticResource MAD.SecondaryText}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Copyright}" Style="{StaticResource MAD.SecondaryText}" />
            </StackPanel>
        </Grid>

        <TabControl Margin="20,0,20,20">
            <TabItem Header="{infra:Loc About.Tab.Overview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel>
                        <Border Style="{StaticResource MAD.Card}" Margin="0,4,0,16" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{infra:Loc About.EngineVersionLabel}" Style="{StaticResource MAD.CaptionText}" />
                                    <TextBlock Text="{Binding EngineVersion}" Style="{StaticResource MAD.BodyText}"
                                               FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{infra:Loc About.ApplicationVersionLabel}" Style="{StaticResource MAD.CaptionText}" />
                                    <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource MAD.BodyText}"
                                               FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Overview, Mode=OneWay}" Style="{StaticResource MAD.BodyText}"
                                   Margin="0,0,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{infra:Loc About.Tab.License}">
                <TextBox Text="{Binding LicenseNotice, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                         FontSize="12" Margin="4" Padding="8"
                         Background="Transparent" BorderThickness="0" />
            </TabItem>
            <TabItem Header="{infra:Loc About.Tab.Acknowledgements}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding Components}"
                             SelectedItem="{Binding SelectedComponent}"
                             DisplayMemberPath="Name" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1" Text="{Binding SelectedAcknowledgement, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8"
                             Background="Transparent" BorderThickness="0" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
