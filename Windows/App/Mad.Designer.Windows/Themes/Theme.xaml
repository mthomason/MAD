<!--
    The Windows application's design system: palette aliases, typography, spacing,
    corner radii, and the shared control styles. It sits on the native WPF Fluent
    theme (Application.ThemeMode) and uses Fluent's dynamic resource keys for
    surfaces and text, so light/dark, the user's accent colour, and high contrast
    follow the system. The view code only references the MAD.* styles below.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Typography -->
    <FontFamily x:Key="MAD.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MAD.IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="MAD.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="MAD.FontSize.Secondary">12</sys:Double>
    <sys:Double x:Key="MAD.FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="MAD.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="MAD.FontSize.Display">28</sys:Double>
    <sys:Double x:Key="MAD.FontSize.Nav">12</sys:Double>

    <!-- Spacing -->
    <Thickness x:Key="MAD.Padding.CommandBar">12,6</Thickness>
    <Thickness x:Key="MAD.Padding.StatusBar">12,3</Thickness>
    <Thickness x:Key="MAD.Padding.Page">24</Thickness>
    <Thickness x:Key="MAD.Padding.Card">16</Thickness>
    <Thickness x:Key="MAD.Padding.Field">8,4</Thickness>
    <Thickness x:Key="MAD.Margin.Section">0,0,0,12</Thickness>
    <Thickness x:Key="MAD.Margin.FieldLabel">0,0,0,2</Thickness>
    <sys:Double x:Key="MAD.NavWidth">88</sys:Double>
    <sys:Double x:Key="MAD.ControlMinHeight">32</sys:Double>

    <!-- Shape -->
    <CornerRadius x:Key="MAD.CornerRadius.Control">4</CornerRadius>
    <CornerRadius x:Key="MAD.CornerRadius.Card">8</CornerRadius>
    <CornerRadius x:Key="MAD.CornerRadius.Pill">16</CornerRadius>

    <!-- Brand. The brand red and icon artwork are reserved (NOTICE); UI chrome uses the
         system accent and Fluent surfaces, which adapt to light/dark and high contrast. -->
    <SolidColorBrush x:Key="MAD.BrandBrush" Color="#CC2922" po:Freeze="True" />
    <SolidColorBrush x:Key="MAD.DeskLightBrush" Color="#E8E8E8" po:Freeze="True" />
    <SolidColorBrush x:Key="MAD.PaperBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="MAD.PaperInkBrush" Color="#1A1A1A" po:Freeze="True" />
    <SolidColorBrush x:Key="MAD.CanvasGridBrush" Color="#14000000" po:Freeze="True" />
    <SolidColorBrush x:Key="MAD.ElementLineBrush" Color="#66808080" po:Freeze="True" />
    <SolidColorBrush x:Key="MAD.SuccessBrush" Color="#107C10" po:Freeze="True" />
    <SolidColorBrush x:Key="MAD.ErrorBrush" Color="#C42B1C" po:Freeze="True" />

    <!-- ===== Text ===== -->
    <Style x:Key="MAD.DisplayText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MAD.TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="MAD.BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MAD.SecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MAD.CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MAD.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource MAD.CaptionText}">
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="MAD.FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="{StaticResource MAD.Margin.FieldLabel}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MAD.StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MAD.ErrorText" TargetType="TextBlock" BasedOn="{StaticResource MAD.StatusText}">
        <Setter Property="Foreground" Value="{StaticResource MAD.ErrorBrush}" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style x:Key="MAD.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MAD.CornerRadius.Card}" />
        <Setter Property="Padding" Value="{StaticResource MAD.Padding.Card}" />
    </Style>

    <Style x:Key="MAD.CommandBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource MAD.Padding.CommandBar}" />
    </Style>

    <Style x:Key="MAD.StatusBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource MAD.Padding.StatusBar}" />
    </Style>

    <Style x:Key="MAD.NavRail" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <Style x:Key="MAD.Desk" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
    </Style>

    <!-- ===== Commands ===== -->





    <!-- A button inside a command bar: icon above/beside a label, transparent chrome. -->
    <Style x:Key="MAD.CommandButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="{StaticResource MAD.ControlMinHeight}" />
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Secondary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A consistent-width insert command in the Designer's palette group. -->
    <Style x:Key="MAD.InsertButton" TargetType="Button" BasedOn="{StaticResource MAD.CommandButton}">
        <Setter Property="MinWidth" Value="102" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- A small square icon-only command (zoom in/out). -->
    <Style x:Key="MAD.IconButton" TargetType="Button" BasedOn="{StaticResource MAD.CommandButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="MAD.PrimaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource MAD.CornerRadius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MAD.SecondaryButton" TargetType="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="18,6" />
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource MAD.CornerRadius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A labelled icon + text pair used inside command buttons. -->
    <Style x:Key="MAD.CommandIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MAD.IconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MAD.CommandLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <!-- ===== Primary navigation rail ===== -->
    <Style x:Key="MAD.NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                CornerRadius="{StaticResource MAD.CornerRadius.Control}"
                                Background="Transparent" />
                        <Border x:Name="Indicator" Width="3" Margin="0,10"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                CornerRadius="1.5" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MAD.NavIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MAD.IconFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
    </Style>

    <Style x:Key="MAD.NavLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Nav}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,5,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
    </Style>

    <!-- ===== Segmented control (a local view/mode switch, not primary navigation) ===== -->
    <Style x:Key="MAD.SegmentedHost" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MAD.CornerRadius.Control}" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style x:Key="MAD.SegmentToggle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="14,3" />
        <Setter Property="FontSize" Value="{StaticResource MAD.FontSize.Secondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Form layout ===== -->
    <Style x:Key="MAD.FormGrid" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="MAD.Divider" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,4" />
    </Style>

    <Style x:Key="MAD.PopupSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource MAD.CornerRadius.Card}" />
        <Setter Property="Padding" Value="{StaticResource MAD.Padding.Card}" />
    </Style>

</ResourceDictionary>
