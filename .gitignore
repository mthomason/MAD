# Runtime logs -- written by the running app, never source.
MADDesigner/run.log

# Warnings-cleanup working documents -- a scratch tracker and its data dump,
# maintained while the warning/analyzer sweep is in flight.  Not source, and
# durable findings are recorded in docs/project/registers/BUGS.md as normal.
docs/project/registers/WARNINGS_PLAN.md
docs/project/registers/WARNINGS_INVENTORY.md

# Local test-database credentials for the live MySQL / SQL Server suites.
# A working note for this machine, not source, and it carries passwords.
docs/project/build/TEST-DB-INFO.md

# AppCode / JetBrains project files, per-developer and regenerated by the IDE
.idea/

# Editor and note-taking state -- per-machine, never source.
.vscode/
.obsidian/

# The CLI's project-local DerivedData (CLI/build.sh)
.cli-deriveddata/

# The mad-action wrapper's default export directory (linux.yml)
mad-output/

Compressor/src/
Compressor/build_temp/
Compressor/bin/iPhoneSimulator-i386.sdk/

# Compressor artifacts -- built on demand by Compressor/build.sh, never
# committed.  (The legacy tracked trees under Compressor/library stay until
# the final untracking step; these patterns cover only the new artifacts.)
Compressor/media/
Compressor/library/*.xcframework/
Compressor/library/.*.new.xcframework/
Compressor/library/manifests/
Compressor/library/*/include/

MADTds/MADTds/freetds/src/
MADTds/MADTds/freetds/source/

# Code signing request
MADRequest.certSigningRequest

# Xcode -- build generated
build/
DerivedData/
*.xcappdata
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Xcode -- per-user project settings (window state, breakpoints, custom
# executables).  The default files stay, should a project need them.
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.moved-aside
*.xccheckout
*.xcscmblueprint

# Xcode -- interface-builder leftovers
*~.nib

# macOS temporary files
.DS_Store
.Trashes
*.swp
*.lock
*~

# make and build files
*.lst
*.o
*.eep
*.lss
*.map
*.sym
*dgph
*.d
*.dia

# Archives and media
*.tar.gz
*.tgz
*.mov
.graffle

# Seems to be a by product of script to increment build counter.
MADAppConfiguration.me

# Jekyll output (local preview of the docs site)
_site/

# Claude Code local settings (machine-specific permission grants)
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc

# The documentation's developer build guides are source, not build output.
!docs/developers/build/
!docs/*/developers/build/
